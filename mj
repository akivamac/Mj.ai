def update_brain(brain_dir):
    """Silently pull latest brain files from GitHub on startup."""
    base_url = 'https://raw.githubusercontent.com/akivamac/Mj.ai/main/brain/'
    files = ['knowledge.json', 'rules.json', 'terminal.json', 'coding.json',
             'templates.json', 'dictionary.json', 'storyBeats.json']
    ctx = ssl.create_default_context()
    for f in files:
        try:
            url = base_url + f
            dest = os.path.join(brain_dir, f)
            with urllib.request.urlopen(url, context=ctx) as resp, open(dest, 'wb') as out:
                out.write(resp.read())
        except Exception:
            pass  # silently fail — use cached version

