            print(f"   echo 'bsk_live_...' > ~/.mj_backside && chmod 600 ~/.mj_backside{RESET}")
        print()

        while True:
            try:
                cols = os.get_terminal_size().columns
                line = '─' * cols

                # Show framed unsent prompt
                print(line)
                user_input = input('❯ ')
                print(line)

                if not user_input.strip():
                    continue

                # Replace the 3 lines (top line + input line + bottom line)
                # with just the black-on-white sent message
                print('\033[3A', end='')   # move cursor up 3 lines
                print('\033[2K', end='')   # clear top line
                print('\033[1B', end='')   # move down 1
                print('\033[2K', end='')   # clear input line
                print(f'\033[30;47m{user_input:<{cols}}\033[0m')  # black on white sent message
                print('\033[2K', end='')   # clear bottom line (cursor is already there)
                print()                    # blank line after sent message

                # Check for commands
                if user_input.lower() == 'exit' or user_input.lower() == 'quit':
                    print("🐒 Bye!")
                    break
                elif user_input.lower() == 'brain':
                    self.brain_stats()
                    continue
                elif user_input.lower() == 'clear':
                    self.history = []
                    print("History cleared.")
                    continue
                elif user_input.lower() == 'help':
                    print("\nCommands:")
                    print("  exit/quit      - Exit mj")
                    print("  brain          - Show brain stats")
                    print("  clear          - Clear history")
                    print("  files          - List all files mj created")
                    print("  push <path>    - Push file to GitHub")
                    print('  """            - Enter multi-line mode\n')
                    continue
                elif user_input.lower() == 'files':
                    if not os.path.exists(FILES_LOG):
                        print("Joe: No files created yet.")
                    else:
                        files = json.loads(open(FILES_LOG).read())
                        if not files:
                            print("Joe: No files created yet.")
                        else:
                            print("Joe: Files I've created:")
                            for f in files:
                                exists = '✅' if os.path.exists(f) else '❌ (deleted)'
                                print(f"  {exists} {f}")
                    continue
                elif user_input.startswith('push '):
                    path = user_input[5:].strip()
                    # Check if file exists, otherwise check ~/.mj_files.json
                    if not os.path.exists(path) and os.path.exists(FILES_LOG):
                        files = json.loads(open(FILES_LOG).read())
                        matching = [f for f in files if os.path.basename(f) == path or f.endswith(path)]
                        if matching:
                            path = matching[0]
                    self.github_push(path)
                    continue
                elif user_input == '"""':
                    # Multi-line mode
                    lines = []
                    print('(Enter lines, end with """ on its own line)')
                    while True:
                        line = input()
                        if line == '"""':
                            break
                        lines.append(line)
                    user_input = '\n'.join(lines)

                # Apply typo correction early
                lower_input = fix_typos(user_input).lower().strip()

                # Apology/correction handling
                apology_triggers = ['sorry', 'oops', 'i meant', 'i mean', 'correction',
                                    'i made a typo', 'typo', 'i mistyped', 'ignore that',
                                    'never mind', 'nevermind', 'scratch that']
                if any(p in lower_input for p in apology_triggers):
                    meant_match = re.search(r'(?:i meant|i mean|correction[:\s])\s+(.+)', lower_input)
                    if meant_match:
                        corrected = meant_match.group(1).strip()
                        lower_input = corrected
                        user_input = corrected
                    else:
                        print("Joe: No worries! What did you mean to ask? 🐒\n")
                        continue

                # Rephrase detection — "i asked if you could X", "i said X", etc.
                rephrase_patterns = [
                    r'i asked (?:if |whether )?(?:you )?(?:could |can |would )?(.+)',
                    r'i said (.+)',
                    r'my question was (.+)',
                    r'i meant (.+)',
                    r'i was asking (?:about |if |whether )?(.+)',
                ]
                for pat in rephrase_patterns:
                    m = re.search(pat, lower_input)
                    if m:
                        user_input = m.group(1).strip()
                        lower_input = user_input.lower()
                        break

                # Greeting check
                greetings_list = ['hi', 'hey', 'hello', 'howdy', 'sup', "what's up", 'whats up',
                                  'yo', 'hiya', 'greetings', 'good morning', 'good afternoon',
                                  'good evening', 'good night', 'morning', 'evening', 'afternoon',
