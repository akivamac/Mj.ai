                               'you are amazing', "you're amazing", 'you are awesome', "you're awesome",
                               'good job', 'well done', 'nice job', 'impressive', 'not bad',
                               'i like you', 'you are cool', "you're cool", 'love you', 'i love you']
                if any(p in lower_input for p in compliments):
                    print(f"Joe: {random.choice(['Aw thanks! 🐒 Just doing my best.', 'You' + chr(39) + 're too kind! Ask me anything.', 'Thanks! Getting smarter every day. 🐒'])}\n")
                    continue

                # Gratitude
                gratitude = ['thank you', 'thanks', 'thx', 'ty', 'cheers', 'appreciate it',
                             'appreciate that', 'helpful', 'that helped', 'that was helpful',
                             'great answer', 'good answer', 'perfect answer']
                if any(p in lower_input for p in gratitude) and len(lower_input.split()) <= 5:
                    print(f"Joe: {random.choice(['Happy to help! 🐒', 'Anytime!', 'Glad that helped! Ask me anything else.', 'You' + chr(39) + 're welcome! What else do you need?'])}\n")
                    continue

                # Affirmations
                affirmations = ['yes', 'yeah', 'yep', 'yup', 'sure', 'absolutely', 'definitely',
                                'of course', 'correct', 'right', 'exactly', 'indeed', 'true',
                                'agreed', 'i agree', 'you are right', "you're right", 'makes sense',
                                'i see', 'got it', 'understood', 'i know', 'i knew that',
                                'ok', 'okay', 'good', 'nice', 'cool', 'great', 'perfect',
                                'awesome', 'alright', 'sounds good', 'interesting', 'wow', 'really']
                if lower_input in affirmations or (len(lower_input.split()) <= 3 and any(lower_input.startswith(a) for a in affirmations)):
                    print(f"Joe: {random.choice(['Great! What else can I help with? 🐒', 'What' + chr(39) + 's next?', 'Ask me anything!', 'What do you want to know?'])}\n")
