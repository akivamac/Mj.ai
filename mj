FILES_LOG = os.path.expanduser('~/.mj_files.json')

def log_file(filepath):
    """Track created files in ~/.mj_files.json"""
    try:
        files = json.loads(open(FILES_LOG).read()) if os.path.exists(FILES_LOG) else []
    except:
        files = []
    abs_path = os.path.abspath(filepath)
    if abs_path not in files:
        files.append(abs_path)
    with open(FILES_LOG, 'w') as f:
        json.dump(files, f)

def update_brain(brain_dir):
    """Silently pull latest brain files from GitHub on startup."""
    base_url = 'https://raw.githubusercontent.com/akivamac/Mj.ai/main/brain/'
    files = ['knowledge.json', 'rules.json', 'terminal.json', 'coding.json']
    ctx = ssl.create_default_context()
    for f in files:
        try:
            url = base_url + f
            dest = os.path.join(brain_dir, f)
            urllib.request.urlretrieve(url, dest, context=ctx)
        except Exception:
            pass  # silently fail — use cached version

