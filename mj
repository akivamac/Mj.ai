                # Get response
                response = self.respond(user_input)

                # Short catch-alls for no-match responses
                question_words = ['what', 'who', 'how', 'why', 'where', 'when', 'which', 'is',
                                  'are', 'do', 'does', 'did', 'can', 'could', 'would', 'should', 'will']
                if response.startswith("Hmm, I don't know"):
                    emotional_words = ['feel', 'love', 'hate', 'miss', 'wish', 'hope', 'scared',
                                       'excited', 'happy', 'sad', 'angry', 'tired', 'nervous', 'worried']
                    is_emotional = any(w in lower_input for w in emotional_words)
                    is_question = any(lower_input.startswith(w) for w in question_words) or '?' in lower_input
                    if is_emotional and not is_question:
                        print(f"Joe: {random.choice(['That sounds meaningful! I can answer questions on lots of topics — what do you want to know? 🐒', 'I hear you! Not much of an emotional support monkey, but I can answer questions. 🐒', 'Thanks for sharing! Ask me a question and I' + chr(39) + 'll do my best.'])}\n")
                    elif self.last_topic_label and len(lower_input.split()) <= 3 and not is_question:
                        print(f"Joe: Not sure about that — did you want to know more about {self.last_topic_label}? 🐒\n")
