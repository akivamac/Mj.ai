                if any(p in lower_input for p in doing_to_joe):
                    print("Joe: I know! Akiva built me and keeps making me smarter. 🐒 Thanks!\n")
                    continue

                # (Removed the REPL "joe_preferences" pre-handler — it printed a
                # generic "no preferences" reply that shadowed respond()'s
                # in-character persona handler. Preference questions now flow to
