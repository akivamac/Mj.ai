def fetch_backside_facts(api_key):
    import subprocess
    facts = []
    cursor = None

    while True:
        url = 'https://api.worktruck.app/api/v1/notes?tag=monkey-joe-brain&limit=100'
        if cursor:
            url += f'&cursor={urllib.parse.quote(cursor, safe="")}'

        cmd = [
            'curl', '-s',
            '-H', f'Authorization: Bearer {api_key}',
            '-H', 'Content-Type: application/json',
            '-H', 'User-Agent: Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36',
            '-H', 'Accept: application/json, text/plain, */*',
            url
        ]
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            data = json.loads(result.stdout)
            for note in (data.get('data') or []):
                keywords = [k.strip() for k in note.get('title', '').split(',')]
                facts.append({'keywords': keywords, 'answer': note.get('body', '')})
            print(f"Joe: Syncing from Backside... {len(facts)} facts loaded", end='\r')
            if not data.get('has_more'):
                break
            cursor = data.get('next_cursor')
            if not cursor:
                break
        except Exception as e:
            print(f'Backside pagination error: {e}')
            break

    return facts

def is_statement_about_joe(text: str) -> bool:
    """Return True if the input is a statement directed at Joe, not a question."""
    lower = text.lower().strip()
    statement_patterns = [
        'you are', 'you were', 'you will', 'you have', 'you look',
        'you seem', 'you sound', 'you feel', 'you act', 'you work',
        'it is', "it isn't", 'it is not', 'this is', 'that is',
        'i think', 'i believe', 'i feel', 'i know', 'i see',
        'i notice', 'i found', 'i found out', 'i realized',
    ]
    question_starters = ['what', 'why', 'how', 'where', 'when', 'who', 'which',
                         'can ', 'do ', 'does ', 'is ', 'are ', 'was ', 'will ',
                         'would ', 'could ', 'should ']
    has_question = any(lower.startswith(q) for q in question_starters) or lower.endswith('?')
    if has_question:
        return False
    return any(lower.startswith(p) for p in statement_patterns)

