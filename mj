    def _classify_math_intent(self, input_str, lower):
        conv = MathEngine.parse_conversion(input_str)
        compute = bool(conv or MathEngine.looks_like_math(input_str))
        # `x` as variable: not glued to another letter (allows `2x`).
        eq_like = '=' in input_str and re.search(r'(?<![a-z])x(?![a-z])', input_str, re.I)
        stats_like = bool(re.match(r'^(mean|median|mode|average|stats|stddev|stdev|variance|sum|range)\b', input_str.strip(), re.I))
        prime_like = bool(re.search(r'\bis\s+\d+\s+prime\b', input_str, re.I))
        factor_like = bool(re.match(r'^(factor|prime factor|factorize|factorise|primes? of)\s+\d+', input_str.strip(), re.I))
        is_computable = compute or eq_like or stats_like or prime_like or factor_like
        if is_computable and self._WORKED_RE.search(input_str): return 'WORKED'
        if is_computable: return 'COMPUTE'
        # Gate = math keyword OR a direct tutorial-trigger hit, so new tutorial
        # topics are reachable without growing the keyword list (v64).
        def math_gate():
            if any(k in lower for k in self._MATH_KEYWORDS): return True
            tuts = (self.math_tutorials or {}).get('tutorials') or []
            return bool(self._find_by_triggers(tuts, lower, 2))
        if self._TEACH_RE.search(input_str) and math_gate():
            return 'TEACH'
        if self._DEFINE_RE.match(input_str) and math_gate() and len(input_str) < 80:
            return 'DEFINE'
        if (len(input_str) < 40 and math_gate()
            and not input_str.endswith('?')
            and re.fullmatch(r"[a-z' \-]+", input_str.strip(), re.I)):
            return 'DEFINE'
        return None

    @staticmethod
    def _math_fmt(n): return MathEngine.format_number(n)

    def _format_equation_answer(self, eq, worked):
        f = self._math_fmt
        if eq.get('type') in ('identity', 'inconsistent'): return eq['text']
        if eq['type'] == 'linear':
            if not worked: return f"x = {f(eq['x'])}"
            return (f"x = {f(eq['x'])}\n\nWork:\n"
                    f"  {eq['lhs']} = {eq['rhs']}\n"
                    f"  {eq['a']}x = {f(-eq['b'])}\n"
                    f"  x = {f(-eq['b'])} / {eq['a']}\n"
                    f"  x = {f(eq['x'])}")
        if eq['type'] == 'quadratic':
            if eq.get('complex'):
                head = f"No real solutions (discriminant = {f(eq['discriminant'])} < 0)."
                if not worked: return head
                return head + (f"\n\nWork:\n  {eq['lhs']} = {eq['rhs']}\n"
                               f"  → {eq['a']}x² + {f(eq['b'])}x + {f(eq['c'])} = 0\n"
                               f"  discriminant = b² - 4ac = {eq['b']}² - 4({eq['a']})({eq['c']}) = {f(eq['discriminant'])}\n"
                               f"  Negative → no real roots.")
            roots = (f"x = {f(eq['x'])} (double root)"
                     if 'x' in eq else f"x = {f(eq['x1'])} or x = {f(eq['x2'])}")
            if not worked: return roots
            sd = math.sqrt(eq['discriminant'])
            return (f"{roots}\n\nWork:\n  {eq['lhs']} = {eq['rhs']}\n"
                    f"  → {eq['a']}x² + {f(eq['b'])}x + {f(eq['c'])} = 0\n"
                    f"  discriminant = b² - 4ac = {eq['b']*eq['b']} - {4*eq['a']*eq['c']} = {f(eq['discriminant'])}\n"
                    f"  x = (-b ± √d) / 2a = ({f(-eq['b'])} ± {f(sd)}) / {f(2*eq['a'])}\n"
                    f"  → {roots}")
        return None

    def _format_stats_summary(self, s, worked):
        f = self._math_fmt
        if not worked:
            return f"mean {f(s['mean'])}, median {f(s['median'])}, stdev {f(s['stdev'])} (n={s['n']})"
        mode_str = f(s['mode']) if s['mode'] is not None else '—'
        return (f"mean {f(s['mean'])}, median {f(s['median'])}, mode {mode_str}, "
                f"stdev {f(s['stdev'])} (n={s['n']})\n\n"
                f"Detail:\n  sum = {f(s['sum'])}\n"
                f"  min = {f(s['min'])}, max = {f(s['max'])}, range = {f(s['range'])}\n"
                f"  variance = {f(s['variance'])}")

    def _format_prime_check(self, n, worked):
        f = self._math_fmt
        p = MathEngine.is_prime(n)
        if not worked:
            return f"Yes — {n} is prime." if p else f"No — {n} = {' × '.join(map(str, MathEngine.prime_factor(n)))}."
        if p:
            return f"Yes — {n} is prime.\n\n(Checked: no divisor between 2 and √{n} = {f(math.sqrt(n))} divides it cleanly.)"
        fac = MathEngine.prime_factor(n)
        return f"No — {n} = {' × '.join(map(str, fac))}.\n\nWork: trial-divided by 2, 3, 5, ... until we found {fac[0]} divides {n}, then continued on the quotient."

