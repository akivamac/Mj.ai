    # ── Storyteller (Python port of js/generator.js) ──────────
    _POS_MAP = {'NOUN': 'noun', 'VERB': 'verb', 'ADJ': 'adjective',
                'ADV': 'adverb', 'CONN': 'connector'}

    _STORY_TONE_KEYWORDS = {
        'silly':       ['silly', 'funny', 'goofy', 'wacky', 'absurd', 'wild', 'hilarious'],
        'spooky':      ['spooky', 'scary', 'creepy', 'ghost', 'eerie', 'haunted', 'horror', 'frightening'],
        'adventure':   ['adventure', 'exciting', 'brave', 'epic', 'heroic', 'quest', 'thrilling', 'daring'],
        'cozy':        ['bedtime', 'cozy', 'calm', 'gentle', 'sleepy', 'peaceful', 'quiet', 'sleep', 'soft', 'soothing'],
        'magical':     ['magical', 'magic', 'fantasy', 'enchanted', 'wondrous', 'mystical', 'fairy', 'fairytale'],
        'bittersweet': ['bittersweet', 'sweet sad', 'gentle sad'],
        'triumphant':  ['triumphant', 'victorious', 'heroic ending', 'epic win', 'glorious'],
        'mysterious':  ['mysterious', 'mystery', 'enigmatic', 'puzzling', 'cryptic'],
        'whimsical':   ['whimsical', 'quirky', 'fanciful', 'odd', 'peculiar'],
        'wistful':     ['wistful', 'nostalgic', 'longing', 'remembering', 'long ago']
    }

    def _detect_story_tone(self, lower):
        for tone, words in self._STORY_TONE_KEYWORDS.items():
            for w in words:
                if re.search(r'\b' + re.escape(w) + r'\b', lower):
                    return tone
        return None

    def _detect_story_mode(self, lower):
        longer = [r'\b(longer|a long|a longer)\s+(story|tale|adventure)\b',
                  r'\bweave\s+(me\s+)?a\s+(tale|story)\b',
                  r'\btell\s+(me\s+)?an?\s+adventure\b',
                  r'\b(epic|grand|sprawling)\s+(story|tale|adventure)\b']
        micro = [r'\b(shorter|short|tiny|quick)\s+(story|tale)\b',
                 r'\bjust\s+one\s+line\b',
                 r'\bone[-\s](line|sentence)\s+(story|tale)\b',
                 r'\bmicro[-\s]?story\b']
        for p in longer:
            if re.search(p, lower, re.I): return 'beats'
        for p in micro:
            if re.search(p, lower, re.I): return 'micro'
        return None

    _STORY_TRIGGERS = [
        r'\b(tell|read|make|give|write|share)\s+(me\s+)?(a|an|another|me\s+a|me\s+an)\s+(\w+\s+)?(story|tale|adventure|book|fable|legend|yarn)\b',
        r'\b(can|could|will|would)\s+you\s+(tell|read|make|give|write|share)\s+(me\s+)?(a|an)\s+(\w+\s+)?(story|tale|adventure|book|fable|legend|yarn)\b',
        r'^(a\s+)?(\w+\s+)?(story|tale|book|fable|legend|yarn)\s+please',
        r'\bmake\s+(up|me)\s+(a|an)\s+(\w+\s+)?(story|tale|adventure|book|fable|legend|yarn)',
        r'^chapter\s+\d+\s+of\s+(?:a|an|the)\s+\w*\s*(?:story|tale|adventure|book)\b',
        r"\b(let'?s|let us|we'?ll|i want to|i'?d like to|i wanna|wanna|want to|can we|shall we)\s+(make|write|create|tell|share|do|start)\s+(up\s+)?(a|an)\s+(\w+\s+)?(story|tale|adventure|book|fable|legend|yarn)\b",
        r'^(make|write|create|tell|start)\s+(a|an)\s+(\w+\s+)?(story|tale|adventure|book|fable|legend|yarn)\b',
        r'\bbedtime\s+story\b',
        r'\b(weave|spin)\s+(me\s+)?a\s+(story|tale|yarn|legend)\b',
        # Mode-prefixed forms ("one line story please", "longer adventure", "micro story")
        r'\b(one[-\s](line|sentence)|micro|tiny|short(er)?|quick|long(er)?|epic|grand|sprawling)\s+(story|tale|adventure|book|fable|legend|yarn)\b'
    ]
    _CONT_TRAIL = r'(\s+(please|now|joe|please now))?[\s!.?]*$'
    _CONTINUATION_PATTERNS = [
        r'^(continue|keep going|keep writing|go on|continue the (story|book|tale))' + _CONT_TRAIL,
        r'^what happens next' + _CONT_TRAIL,
        r'^(tell me more|more please|more story|i want more|more!?)[\s!.?]*$',
        # chapter/part continuations incl. "make/write the next chapter" (v66)
        r'^(make|write|do|give me|create|start|add|spin|read)\s+(me\s+)?(the\s+|a\s+|another\s+)?(next\s+)?(chapter|part|page|section)' + _CONT_TRAIL,
        r'^(the\s+)?next (chapter|part|page|section)' + _CONT_TRAIL,
        r'^(another|one more) (chapter|part|page|section|bit)' + _CONT_TRAIL,
        r'^next' + _CONT_TRAIL,
        r'^(the next part|then what|and then\??|and\?)[\s!.?]*$'
    ]
    _RESET_PATTERNS = [
        r'^(end (the |my )?story|stop (the |my )?story|end story|stop story)[\s!.?]*$',
        r'^(new story|start over|reset story|forget that story)[\s!.?]*$',
        r"^(that's enough|i'm done)[\s!.?]*$"
    ]
    _ANOTHER_PATTERNS = [
        r'^(another|one more|another one|do another|tell another|give another|one more please|another please)[\s!.?]*$',
        r'^(another (story|tale)|one more (story|tale))[\s!.?]*$'
    ]

    def _detect_story_continuation(self, line):
        return any(re.match(p, line.strip(), re.I) for p in self._CONTINUATION_PATTERNS)

    def _detect_story_reset(self, line):
        return any(re.match(p, line.strip(), re.I) for p in self._RESET_PATTERNS)

    def _detect_another(self, line):
        return any(re.match(p, line.strip(), re.I) for p in self._ANOTHER_PATTERNS)

    def _detect_about_micro(self, lower):
        m = re.match(r'^(?:tell me|what)\s+about\s+(?:a|an)\s+([a-z]+)\s+([a-z]+)[\s!.?]*$', lower, re.I)
        return {'adj': m.group(1), 'noun': m.group(2)} if m else None

    def _is_story_request(self, text):
        return any(re.search(p, text, re.I) for p in self._STORY_TRIGGERS)

    def _pick(self, arr):
        return random.choice(arr) if arr else ''

    def _is_known_noun(self, word):
        words = (self.dictionary or {}).get('words') or []
        if not word: return False
        wl = word.lower()
        return any(w.get('pos') == 'noun' and w.get('word','').lower() == wl for w in words)

    def _pick_word(self, slot, tone):
        words = (self.dictionary or {}).get('words') or []
        if not words: return ''
        parts = slot.split(':')
        want_pos = self._POS_MAP.get(parts[0], parts[0].lower())
        theme = parts[1] if len(parts) > 1 else None
        candidates = [w for w in words
                      if w.get('pos') == want_pos
                      and (theme is None or theme in (w.get('themes') or []))]
        if not candidates and theme:
            candidates = [w for w in words if w.get('pos') == want_pos]
        if not candidates: return ''
        if tone:
            toned = [w for w in candidates if tone in (w.get('tone') or [])]
            if toned: candidates = toned
        # de-rep
        key = f'{want_pos}:{theme or ""}'
        recent = self._recent_words.get(key, [])
        if recent:
            fresh = [w for w in candidates if w['word'] not in recent]
            if fresh: candidates = fresh
        chosen = self._pick(candidates)['word']
        bucket = self._recent_words.setdefault(key, [])
        bucket.append(chosen)
        if len(bucket) > self._recent_limit: bucket.pop(0)
        return chosen

    # ── English pluralization ──────────────────────────────
    _IRREGULAR_PLURALS = {
        'jellyfish': 'jellyfish', 'octopus': 'octopuses', 'equinox': 'equinoxes',
        'ox': 'oxen', 'mouse': 'mice', 'goose': 'geese',
        'wolf': 'wolves', 'leaf': 'leaves', 'half': 'halves',
        'knife': 'knives', 'life': 'lives', 'self': 'selves', 'thief': 'thieves',
        'child': 'children', 'person': 'people',
        'foot': 'feet', 'tooth': 'teeth',
        'cactus': 'cacti', 'fungus': 'fungi', 'nucleus': 'nuclei', 'alumnus': 'alumni',
        'criterion': 'criteria', 'phenomenon': 'phenomena',
        'index': 'indices', 'matrix': 'matrices', 'vertex': 'vertices'
    }
    _F_EXCEPTIONS = {'roof','chief','belief','cliff','cuff',
                     'gulf','reef','safe','cafe','proof','staff'}

    @classmethod
    def _pluralize(cls, word):
        if not word: return word
        lw = word.lower()
        if lw in cls._IRREGULAR_PLURALS: return cls._IRREGULAR_PLURALS[lw]
        if re.search(r'[^aeiou]y$', word, re.I): return word[:-1] + 'ies'
        if re.search(r'(?:s|x|z|ch|sh)$', word, re.I): return word + 'es'
        if re.search(r'fe$', word, re.I) and lw not in cls._F_EXCEPTIONS:
            return word[:-2] + 'ves'
        if re.search(r'f$', word, re.I) and lw not in cls._F_EXCEPTIONS:
            return word[:-1] + 'ves'
        return word + 's'

    _CLOSER_STOPWORDS = {
        'again','still','about','where','their','those','these','would','could',
        'should','might','first','small','great','every','until','while','being',
        'there','which','other','after','before','around','always','never'
    }

    @classmethod
    def _extract_stems(cls, text):
        return {w for w in re.findall(r'[a-z]{5,}', text.lower())
                if w not in cls._CLOSER_STOPWORDS}

    # Strip parenthetical with digits, take first sentence, cap 120 chars.
    @staticmethod
    def _fact_snippet(answer):
        if not answer: return ''
        cleaned = re.sub(r'\s*\([^)]*\d[^)]*\)', '', answer)
        cleaned = re.sub(r'\s+', ' ', cleaned).strip()
        # First sentence — split on sentence-ending punctuation FOLLOWED by a
        # space, so a decimal point ("98.7%") isn't read as a sentence end and
        # truncated to "98." (Bug 4).
        parts = re.split(r'(?<=[.!?])\s+', cleaned)
        first = (parts[0] if parts else cleaned).strip()
        if len(first) > 120:
            cut = first[:120]
            last_space = cut.rfind(' ')
            first = (cut[:last_space] if last_space > 0 else cut).strip() + '...'
        return first

    def _fill_template(self, text, opts):
        bindings = {}
        if opts.get('character'): bindings['NOUN:character'] = opts['character']
        if opts.get('place'):     bindings['NOUN:place']     = opts['place']
        # Bind any given subject to the character slot (not just known nouns)
        # so story subjects actually appear. v59 fix (mirror of generator.js).
        if opts.get('subject'):
            bindings.setdefault('NOUN:character', opts['subject'])
        fact_text = self._fact_snippet(opts.get('fact'))

        # Trailing `s` (followed by a word boundary) after a NOUN slot is a
        # plural marker — pluralize() instead of leaving a literal `s`.
        def repl(m):
            slot = m.group(1)
            suffix = m.group(2) or ''
            if slot == 'FACT':
                return fact_text + suffix
            is_noun = slot.startswith('NOUN')
            if is_noun and slot in bindings:
                word = bindings[slot]
            else:
                word = self._pick_word(slot, opts.get('tone'))
                if is_noun: bindings[slot] = word
            if suffix and is_noun:
                return self._pluralize(word)
            return word + suffix

        out = re.sub(r'\{([^}]+)\}(s\b)?', repl, text)
        return out, bindings

    @staticmethod
    def _fix_articles(s):
        return re.sub(r"\b(a|an|A|An)\s+([A-Za-z][A-Za-z']*)",
                      lambda m: ( ('an' if re.match(r'^[aeiou]', m.group(2), re.I) else 'a').capitalize()
                                  if m.group(1)[0].isupper()
                                  else ('an' if re.match(r'^[aeiou]', m.group(2), re.I) else 'a')
                                ) + ' ' + m.group(2), s)

    @staticmethod
    def _fix_sentence_case(s):
        return re.sub(r'(^|[.!?]\s+)([a-z])',
                      lambda m: m.group(1) + m.group(2).upper(), s)

    def _pick_closer(self, tone):
        closers = (self.templates or {}).get('closers') or []
        if not closers: return None
        # Tolerate string OR {text,tone} entries (defensive).
        closers = [{'tone': [], 'text': c} if isinstance(c, str) else c for c in closers]
        pool = closers
        if tone:
            toned = [c for c in pool if tone in (c.get('tone') or [])]
            if toned: pool = toned
        # Drop closers sharing a stem with anything in the recent window.
        recent_union = set()
        for s in self._recent_closer_stems: recent_union |= s
        drop_stems = ([c for c in pool
                       if not (self._extract_stems(c['text']) & recent_union)]
                      if recent_union else pool)
        drop_texts = [c for c in drop_stems
                      if c['text'] not in self._recent_closer_texts]
        pool = drop_texts if drop_texts else (drop_stems if drop_stems else pool)
        chosen = self._pick(pool)
        self._recent_closer_stems.append(self._extract_stems(chosen['text']))
        self._recent_closer_texts.append(chosen['text'])
        if len(self._recent_closer_stems) > self._closer_stem_history:
            self._recent_closer_stems.pop(0)
        if len(self._recent_closer_texts) > self._closer_stem_history:
            self._recent_closer_texts.pop(0)
        # Closers may contain slots — fill them so {NOUN:plant} etc.
        # don't leak raw to the user.
        filled, _ = self._fill_template(chosen['text'], {'tone': tone})
        return self._fix_sentence_case(self._fix_articles(filled))

    def _pick_pacing(self):
        p = (self.templates or {}).get('pacingBeats') or []
        if not p: return None
        c = self._pick(p)
        return c if isinstance(c, str) else c.get('text')

    def _pick_template(self, opts):
        t = self.templates or {}
        if opts.get('mode') == 'micro' and t.get('microStories'):
            pool = t['microStories']
            # Prefer micro templates with a character slot when a subject is
            # given, so the subject lands in the story. v59 fix.
            if opts.get('subject'):
                # Templates are plain strings (legacy ones may be {text}) —
                # handle both so the preference actually fires (v62 fix).
                with_char = [s for s in pool if '{NOUN:character}' in (s if isinstance(s, str) else (s.get('text') or ''))]
                if with_char: pool = with_char
        elif opts.get('continuation') and t.get('continuations'):
            pool = t['continuations']
        elif opts.get('fact') and t.get('factStories'):
            pool = t['factStories']
        else:
            pool = t.get('stories', [])
        if opts.get('tone'):
            toned = [s for s in pool if opts['tone'] in ((s.get('tone') if isinstance(s, dict) else None) or [])]
            if toned: return self._pick(toned)
        return self._pick(pool) if pool else None

    def _generate_beat_story(self, opts):
        beats = (self.story_beats or {}).get('beats') or []
        if not beats:
            return self.generate_story({**opts, 'mode': 'regular'})
        tone = opts.get('tone')
        by_id = {b['id']: b for b in beats}
        def by_type(t): return [b for b in beats if b.get('type') == t]
        def match_tone(lst):
            if not tone: return lst
            t = [b for b in lst if tone in (b.get('tone') or [])]
            return t if t else lst

        used_beat_ids = set()
        def drop_blocked(lst):
            fresh = [b for b in lst
                     if b['id'] not in used_beat_ids
                     and b['id'] not in self._recent_beat_ids]
            return fresh if fresh else lst

        openings = drop_blocked(match_tone(by_type('opening')))
        if not openings:
            return self.generate_story({**opts, 'mode': 'regular'})
        current = self._pick(openings)

        chain = []
        target_len = 4 + random.randint(0, 2)  # 4..6
        for i in range(target_len + 2):
            chain.append(current)
            used_beat_ids.add(current['id'])
            if current.get('type') == 'closing': break
            nexts = current.get('next_beats') or []
            if not nexts: break
            cands = [by_id[i_] for i_ in nexts if i_ in by_id]
            if not cands: break
            if i >= 3:
                endish = [b for b in cands if b.get('type') in ('closing', 'resolution')]
                if endish: cands = endish
            cands = match_tone(cands)
            cands = drop_blocked(cands)
            current = self._pick(cands)

        if chain[-1].get('type') != 'closing':
            cl = drop_blocked(match_tone(by_type('closing')))
            if cl: chain.append(self._pick(cl))

        # Record this chain so the next story avoids these beats.
        for b in chain:
            self._recent_beat_ids.append(b['id'])
            if len(self._recent_beat_ids) > self._beat_history:
                self._recent_beat_ids.pop(0)

        character = opts.get('character')
        place     = opts.get('place')
        subject   = opts.get('subject')

        lines = []
        for i, b in enumerate(chain):
            text, bindings = self._fill_template(b['text'],
                {'tone': tone, 'character': character, 'place': place, 'subject': subject})
            character = character or bindings.get('NOUN:character')
            place     = place     or bindings.get('NOUN:place')
            lines.append(text)
            if i < len(chain) - 1 and chain[i+1].get('type') != 'closing' and random.random() < 0.28:
                p = self._pick_pacing()
                if p: lines.append(p)
        text = self._fix_sentence_case(self._fix_articles(' '.join(lines)))
        closer = self._pick_closer(tone)
        if closer: text += '\n\n' + closer
        return {'text': text, 'character': character, 'place': place,
                'tone': tone, 'subject': subject, 'mode': 'beats'}

    def generate_story(self, opts=None):
        opts = dict(opts or {})
        templates_ok = bool((self.templates or {}).get('stories'))
        dict_ok = bool((self.dictionary or {}).get('words'))
        if not templates_ok:
            return {'text': "I want to tell stories, but my story-brain isn't loaded yet! 🐒"}
        if not dict_ok:
            return {'text': "I want to tell stories, but my word-brain isn't loaded yet! 🐒"}
        opts.setdefault('tone', None)
        opts.setdefault('subject', None)
        opts.setdefault('fact', None)
        opts.setdefault('character', None)
        opts.setdefault('place', None)
        opts.setdefault('continuation', False)
        opts.setdefault('mode', 'regular')
        if opts['mode'] == 'beats':
            return self._generate_beat_story(opts)
        tpl = self._pick_template(opts)
        if not tpl:
            return {'text': "My templates ran dry! 🐒"}
        tpl_text = tpl['text'] if isinstance(tpl, dict) else tpl
        filled, bindings = self._fill_template(tpl_text, opts)
        text = self._fix_sentence_case(self._fix_articles(filled))
        if opts['mode'] == 'regular' and not opts['continuation'] and random.random() < 0.4:
            c = self._pick_closer(opts['tone'])
            if c: text += '\n\n' + c
        return {'text': text,
                'character': bindings.get('NOUN:character'),
                'place':     bindings.get('NOUN:place'),
                'tone': opts['tone'], 'subject': opts['subject'], 'mode': opts['mode']}

    # ── Story-subject helpers (port of brain.js) ─────────
    def _extract_story_subject(self, lower):
        raw = None
        m = re.search(r"\babout\s+(?:a|an|the|some|my|your)?\s*([a-z][a-z\s\-']*?)(?:\s*[?.!,;]|$)", lower)
        if m: raw = m.group(1).strip()
        # "story about it/that/this" — resolve the pronoun to whatever we were
        # just talking about; never weave the literal "it" into a story. (v79 R5)
        if raw and re.fullmatch(r"(it|that|this|them|those|these|one|him|her|its)", raw):
            raw = self._story_hook_subject or self.last_topic_label or (
                self.story_session.get('subject') if self.story_session else None) or None
        if not raw:
            m = re.search(r"\b(?:a|an|the)\s+([a-z\-]+)\s+(?:story|tale|adventure)\b", lower)
            if m:
                word = m.group(1)
                tone_words = sum(self._STORY_TONE_KEYWORDS.values(), [])
                size_or_count = ['short','long','quick','small','big','little','tiny','huge',
                                 'bedtime','good','nice','new','another','longer','shorter']
                if word not in tone_words and word not in size_or_count:
                    raw = word
        if not raw: return {'raw': None, 'singular': None, 'lastWord': None, 'lastSingular': None}
        raw = re.sub(r'[.!?,;]+$', '', raw).strip()
        def singularize(w):
            if not w or len(w) <= 3: return w
            if w.endswith('ies'): return w[:-3] + 'y'
            if re.search(r'(us|is|ss)$', w): return w
            if w.endswith('ses'): return w[:-2]
            if w.endswith('s'): return w[:-1]
            return w
        singular = singularize(raw)
        words = raw.split()
        last_word = words[-1] if len(words) > 1 else None
        last_singular = singularize(last_word) if last_word else None
        return {'raw': raw, 'singular': singular, 'lastWord': last_word, 'lastSingular': last_singular}

    def _find_fact_for_subject(self, subject):
        if not subject or not subject.get('raw'): return None
        tries = []
        for v in [subject.get('raw'), subject.get('singular'),
                  subject.get('lastWord'), subject.get('lastSingular')]:
            if v and v not in tries: tries.append(v)
        all_facts = list(self.knowledge or []) + list(self.coding or [])
        for term in tries:
            tl = term.lower()
            for fact in all_facts:
                for kw in (fact.get('keywords') or []):
                    if tl == kw.lower(): return fact
        return None

    # ── Phase 3: response flavoring ────────────────────────
    FLAVOR_CHANCE       = 0.25
    FLAVOR_CHANCE_BUSY  = 0.05
    PROCEDURAL_CHANCE   = 0.30
    STORY_HOOK_CHANCE   = 0.15
    SKIP_FLAVOR_WORDS   = ['just ', ' just', 'quick', 'briefly', 'short',
                           'tldr', 'tl;dr']

    def _render_flavor(self, text, tone):
        """Fill {SLOT} placeholders in flavor text using the generator."""
        if not text or not self.dictionary or not self.dictionary.get('words'):
            return text
        filled, _ = self._fill_template(text, {'tone': tone})
        return self._fix_sentence_case(self._fix_articles(filled))

    def _pick_toned_flavor(self, pool, tone):
        if not pool: return None
        if tone:
            toned = [e for e in pool if tone in (e.get('tone') or [])]
            if toned: return random.choice(toned)
        return random.choice(pool)

    def _should_flavor(self, lower):
        if not self.response_flavors: return False
        for w in self.SKIP_FLAVOR_WORDS:
            if w in lower: return False
        chance = (self.FLAVOR_CHANCE_BUSY if self._recent_flavor_age <= 2
                  else self.FLAVOR_CHANCE)
        return random.random() < chance

    def _flavor_fact(self, answer, tone):
        f = self.response_flavors or {}
        types = []
        if f.get('leadIns'):       types.append('leadIn')
        if f.get('signOffs'):      types.append('signOff')
        if f.get('responseWraps'): types.append('wrap')
        if not types or not answer: return answer
        t = random.choice(types)
        if t == 'leadIn':
            e = self._pick_toned_flavor(f['leadIns'], tone)
            return self._render_flavor(e['text'], tone) + '\n\n' + answer if e else answer
        if t == 'signOff':
            e = self._pick_toned_flavor(f['signOffs'], tone)
            return answer + '\n\n' + self._render_flavor(e['text'], tone) if e else answer
        e = random.choice(f['responseWraps'])
        if not e or not e.get('before') or not e.get('after'): return answer
        return (self._render_flavor(e['before'], None) + '\n\n' + answer +
                '\n\n' + self._render_flavor(e['after'], None))

    def _maybe_append_story_hook(self, answer, fact):
        if not fact or not fact.get('keywords'): return answer
        if random.random() >= self.STORY_HOOK_CHANCE: return answer
        self._story_hook_subject  = fact['keywords'][0]
        self._story_hook_keywords = list(fact['keywords'])
        self._story_hook_age      = 0
        return answer + "\n\nWant a story about that? Just say 'tell me a story about it' 🐒"

    def _with_procedural(self, text):
        """Maybe prepend a one-sentence microStory to a short canned reply."""
        if not self.templates or not self.dictionary: return text
        if random.random() >= self.PROCEDURAL_CHANCE: return text
        tone = random.choice([None, 'silly', 'cozy', 'whimsical'])
        r = self.generate_story({'mode': 'micro', 'tone': tone})
        out = (r or {}).get('text', '')
        if not out or out.startswith('I want to tell stories'): return text
        return out + ' ' + text

    _STORY_HOOK_YES_RE = re.compile(
        r'^(yes|yeah|sure|yep|yup|ok|okay|go on|do it|please do|tell me|'
        r'tell me a story(?: about it)?|story please)[\s!.?]*$', re.I)

    def _is_story_hook_yes(self, lower):
        if self._story_hook_age > 2 or not self._story_hook_subject:
            return False
        return bool(self._STORY_HOOK_YES_RE.match(lower.strip()))

