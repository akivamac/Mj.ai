            return 'SCIENCE_DEFINE'
        if (len(input_str) < 40 and not input_str.endswith('?')
            and re.fullmatch(r"[a-z' \-]+", input_str.strip(), re.I)):
            return 'SCIENCE_DEFINE'
        return None

    @staticmethod
    def _extract_named_numbers(input_str, variables):
        out = {}
        if not variables: return out
        lc = input_str.lower()
        for v in variables:
            name = v.get('name', '')
            label = (v.get('label') or '').lower()
            m = re.search(r'\b' + re.escape(name) + r'\s*=\s*(-?\d+(?:\.\d+)?)', input_str, re.I)
            if not m and label:
                m = re.search(r'\b' + re.escape(label).replace(r'\ ', r'\s+')
                              + r'\s*(?:=|is|of)?\s*(-?\d+(?:\.\d+)?)', lc)
            if m:
                out[name] = float(m.group(1))
                if label: out[label] = float(m.group(1))
        return out

    def _compute_formula(self, formula, input_str):
        if not formula or not formula.get('compute'): return None
        variables = formula.get('variables', [])
        vals = self._extract_named_numbers(input_str, variables)
        need = [v['name'] for v in variables]
        missing = [n for n in need if vals.get(n) is None]
        if missing: return {'missing': missing}
        expr = formula['compute']
        for v in variables:
            expr = re.sub(r'\b' + re.escape(v['name']) + r'\b',
                          '(' + str(vals[v['name']]) + ')', expr)
        r = MathEngine.evaluate_expression(expr)
        if not r or 'error' in r: return None
        return {'value': r['value'], 'vars': vals, 'expr': expr}

    def _handle_science_intent(self, intent, input_str, lower):
        tutorials = (self.science_tutorials or {}).get('tutorials') or []
        if not tutorials: return None
        tut = self._find_by_triggers(tutorials, lower, min_score=1)
        if not tut: return None
        out = f"**{tut['title']}**"
        if tut.get('formula') and tut['formula'].get('expression'):
            out += f"   _{tut['formula']['expression']}_"
        out += '\n\n' + tut.get('body', '')
        if intent == 'SCIENCE_FORMULA' and tut.get('formula'):
            r = self._compute_formula(tut['formula'], input_str)
            if r and r.get('value') is not None:
                lbl = tut['formula'].get('result_label', 'result')
                unit = tut['formula'].get('result_unit', '')
                out += f"\n\n_Computed:_ {lbl} = {MathEngine.format_number(r['value'])}"
                if unit: out += f" {unit}"
            elif r and r.get('missing'):
                miss = ' '.join(f"{n}=…" for n in r['missing'])
                out += f"\n\n_Tip:_ to compute, give me values like `{miss}`."
        elif tut.get('example'):
            out += f"\n\n_Example:_ {tut['example']}"
        if tut.get('tryIt'): out += '\n\n' + tut['tryIt']
        return out

    def _maybe_garnish_science(self, answer, input_str, lower):
        garnishes = (self.science_flavors or {}).get('garnishes') or []
        if not garnishes or not answer or not isinstance(answer, str): return answer
        if any(w in lower for w in self.SKIP_FLAVOR_WORDS): return answer
        if random.random() >= self.MATH_GARNISH_CHANCE: return answer
        ans = answer.strip()
        cands = []
        for g in garnishes:
            mt, trigs = g.get('match_type'), g.get('triggers', [])
            if mt == 'any':
                cands.append(g); continue
            if mt == 'input_contains' and any(s.lower() in lower for s in trigs):
                cands.append(g)
            elif mt == 'answer_equals' and any(ans == s for s in trigs):
                cands.append(g)
            elif mt == 'answer_contains' and any(s in ans for s in trigs):
                cands.append(g)
        if not cands: return answer
        specific = [g for g in cands if g.get('match_type') != 'any']
        pool = specific if specific else cands
        return answer + '\n' + random.choice(pool)['text']

