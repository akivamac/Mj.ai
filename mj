# ── Math engine (v55, Python mirror of js/math.js) ─────────
#
# Pure stdlib — math, statistics, re, fractions. Safe expression eval
# (no eval()) via tokenize + recursive descent. Unit conversion via
# factor + offset table. Equation solver via 3-point sampling trick.

class MathEngine:

    # ---------- expression evaluator ----------
    _FUNCS = {
        'sqrt': math.sqrt, 'abs': abs,
        'sin': lambda x: math.sin(math.radians(x)),
        'cos': lambda x: math.cos(math.radians(x)),
        'tan': lambda x: math.tan(math.radians(x)),
        'asin': lambda x: math.degrees(math.asin(x)),
        'acos': lambda x: math.degrees(math.acos(x)),
        'atan': lambda x: math.degrees(math.atan(x)),
        'sinh': math.sinh, 'cosh': math.cosh, 'tanh': math.tanh,
        'log10': math.log10, 'log': math.log10, 'ln': math.log,
        'floor': math.floor, 'ceil': math.ceil, 'round': lambda x: round(x),
        'exp': math.exp, 'min': min, 'max': max,
        'factorial': lambda n: math.factorial(int(n)) if n == int(n) and n >= 0 else (_ for _ in ()).throw(ValueError('factorial needs a non-negative integer'))
    }

    @staticmethod
    def _preprocess(s):
        t = s.lower()
        # unicode math operators -> ASCII (×, ÷, ⋅, •, ·, ∗, minus-sign)
        t = re.sub(r'[×⋅∗•·]', '*', t)
        t = re.sub(r'÷', '/', t)
        t = re.sub(r'[−–—]', '-', t)
        t = re.sub(r'(\d)\s*x\s*(?=\d)', r'\1*', t)  # "300 x 7" -> "300*7"
        # strip thousands separators ("6,000" -> "6000"); only comma + 3 digits
        while True:
            nt = re.sub(r'(\d),(\d{3})(?=\D|$)', r'\1\2', t)
            if nt == t: break
            t = nt
        t = re.sub(r'\bdivided by\b', '/', t)
        t = re.sub(r'\bmultiplied by\b', '*', t)
        t = re.sub(r'\btimes\b', '*', t)
        t = re.sub(r'\bplus\b', '+', t)
        t = re.sub(r'\bminus\b', '-', t)
        t = re.sub(r'\bover\b', '/', t)
        t = re.sub(r'\bmod(?:ulo)?\b', '%', t)
        t = re.sub(r'\bto the power of\b', '^', t)
        t = re.sub(r'\bsquared\b', '^2', t)
        t = re.sub(r'\bcubed\b', '^3', t)
        # "square root of N" / "cube root of N"
        t = re.sub(r'\b(?:the\s+)?square\s+root\s+of\s+(\d+(?:\.\d+)?)', r'sqrt(\1)', t)
        t = re.sub(r'\b(?:the\s+)?cube\s+root\s+of\s+(\d+(?:\.\d+)?)', r'(\1)^(1/3)', t)
        # "half of N", "double N", "triple N", "round N"
        t = re.sub(r'\b(?:a\s+)?half\s+of\s+(\d+(?:\.\d+)?)', r'(\1)/2', t)
        t = re.sub(r'\bdouble\s+(\d+(?:\.\d+)?)', r'(\1)*2', t)
        t = re.sub(r'\btriple\s+(\d+(?:\.\d+)?)', r'(\1)*3', t)
        t = re.sub(r'\bquadruple\s+(\d+(?:\.\d+)?)', r'(\1)*4', t)
        t = re.sub(r'\bround\s+(\d+(?:\.\d+)?)', r'round(\1)', t)
        t = re.sub(r'(\d+(?:\.\d+)?)\s*%\s*of\s+', r'(\1/100)*', t)
        t = re.sub(r'(\d+(?:\.\d+)?)\s*%(?!\s*\d)', r'(\1/100)', t)
        t = re.sub(r"^(what\s+is|what'?s|whats|what about|how about|and what(?:'?s| is| about)?|calculate|compute|evaluate|work out|solve|how much is|how much)\s+", '', t, flags=re.I)
        t = re.sub(r'[?.]+$', '', t).strip()
        # natural-language binary ops: "(the) sum of A and B", etc.
        t = re.sub(r'^(?:the\s+)?sum\s+of\s+(.+?)\s+and\s+(.+)$', r'(\1)+(\2)', t)
        t = re.sub(r'^(?:the\s+)?product\s+of\s+(.+?)\s+and\s+(.+)$', r'(\1)*(\2)', t)
        t = re.sub(r'^(?:the\s+)?difference\s+(?:of|between)\s+(.+?)\s+and\s+(.+)$', r'(\1)-(\2)', t)
        t = re.sub(r'^(?:the\s+)?quotient\s+of\s+(.+?)\s+and\s+(.+)$', r'(\1)/(\2)', t)
        # "(the) sum/total of 2+3" — lead-in on an expression that already has
        # an operator (lookahead needs the operator before any comma, so stats
        # lists "sum of 2,3,4" stay intact).
        t = re.sub(r'^(?:the\s+)?(?:sum|total)\s+of\s+(?=[^,]*[-+*/^])', '', t)
        t = re.sub(r'\bpi\b', '(' + str(math.pi) + ')', t)
        t = re.sub(r"\beuler('s)?\s+number\b", '(' + str(math.e) + ')', t)
        return t

    @staticmethod
    def looks_like_math(input_str):
        t = MathEngine._preprocess(input_str)
        if not t: return False
        if not re.search(r'\d', t): return False
        if not re.search(r'[+\-*/%^()]|sqrt|abs|sin|cos|tan|asin|acos|atan|log|ln|floor|ceil|round|factorial|exp', t):
            return False
        stripped = re.sub(r'sqrt|abs|sinh|cosh|tanh|asin|acos|atan|sin|cos|tan|log10|log|ln|floor|ceil|round|factorial|exp|min|max', '', t)
        stripped = re.sub(r'[\d.\s+\-*/%^()!,]', '', stripped)
        return len(stripped) == 0

    @staticmethod
    def _tokenize(s):
        tokens, i = [], 0
        while i < len(s):
            c = s[i]
            if c.isspace(): i += 1; continue
            if c.isdigit() or (c == '.' and i+1 < len(s) and s[i+1].isdigit()):
                j = i
                while j < len(s) and (s[j].isdigit() or s[j] == '.'): j += 1
                tokens.append(('num', float(s[i:j])))
                i = j; continue
            if c.isalpha():
                j = i
                while j < len(s) and (s[j].isalnum()): j += 1
                tokens.append(('ident', s[i:j].lower()))
                i = j; continue
            if c in '+-*/%^()!,':
                tokens.append(('op', c)); i += 1; continue
            raise ValueError('unexpected character: ' + c)
        return tokens

    class _Parser:
        def __init__(self, tokens):
            self.tokens = tokens; self.pos = 0
        def peek(self): return self.tokens[self.pos] if self.pos < len(self.tokens) else None
        def eat(self, type_, value=None):
            t = self.peek()
            if t is None: raise ValueError('unexpected end of expression')
            if t[0] != type_ or (value is not None and t[1] != value):
                raise ValueError(f'expected {value or type_}, got {t[1]}')
            self.pos += 1; return t
        def expr(self): return self.addsub()
        def addsub(self):
            left = self.muldiv()
            while self.peek() and self.peek()[0] == 'op' and self.peek()[1] in '+-':
                op = self.eat('op')[1]
                right = self.muldiv()
                left = left + right if op == '+' else left - right
            return left
        def muldiv(self):
            left = self.power()
            while self.peek() and self.peek()[0] == 'op' and self.peek()[1] in '*/%':
                op = self.eat('op')[1]
                right = self.power()
                if op == '*': left = left * right
                elif op == '/':
                    if right == 0: raise ZeroDivisionError('division by zero')
                    left = left / right
                else: left = left % right
            return left
        def power(self):
            base = self.unary()
            if self.peek() and self.peek()[0] == 'op' and self.peek()[1] == '^':
                self.eat('op')
                exp = self.power()
                return math.pow(base, exp)
            return base
        def unary(self):
            if self.peek() and self.peek()[0] == 'op' and self.peek()[1] in '+-':
                op = self.eat('op')[1]
                v = self.unary()
                return v if op == '+' else -v
            return self.postfix()
        def postfix(self):
            v = self.atom()
            while self.peek() and self.peek()[0] == 'op' and self.peek()[1] == '!':
                self.eat('op')
                v = MathEngine._FUNCS['factorial'](v)
            return v
        def atom(self):
            t = self.peek()
            if t is None: raise ValueError('unexpected end of expression')
            if t[0] == 'num':
                self.eat('num'); return t[1]
            if t[0] == 'op' and t[1] == '(':
                self.eat('op', '(')
                v = self.expr()
                self.eat('op', ')')
                return v
            if t[0] == 'ident':
                self.eat('ident')
                name = t[1]
                if self.peek() and self.peek()[0] == 'op' and self.peek()[1] == '(':
                    if name not in MathEngine._FUNCS:
                        raise ValueError(f'unknown function: {name}')
                    self.eat('op', '(')
                    args = [self.expr()]
                    while self.peek() and self.peek()[0] == 'op' and self.peek()[1] == ',':
                        self.eat('op', ','); args.append(self.expr())
                    self.eat('op', ')')
                    return MathEngine._FUNCS[name](*args)
                if name == 'pi': return math.pi
                if name == 'e':  return math.e
                raise ValueError(f'unknown identifier: {name}')
            raise ValueError(f'unexpected token: {t}')

    @staticmethod
    def evaluate_expression(input_str):
        try:
            cleaned = MathEngine._preprocess(input_str)
            if not cleaned: return None
            tokens = MathEngine._tokenize(cleaned)
            if not tokens: return None
            parser = MathEngine._Parser(tokens)
            value = parser.expr()
            if parser.pos < len(tokens): raise ValueError('trailing tokens after expression')
            return {'value': value, 'cleaned': cleaned}
        except Exception as e:
            return {'error': str(e)}

    @staticmethod
    def format_number(n):
        if n != n or n == float('inf') or n == float('-inf'): return str(n)
        if abs(n) >= 1e15 or (0 < abs(n) < 1e-4):
            return f'{n:.6e}'
        rounded = round(n * 1e10) / 1e10
        if rounded == int(rounded): return str(int(rounded))
        return str(rounded)

