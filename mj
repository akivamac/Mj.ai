    @staticmethod
    def _looks_like_code(input_str):
        if not input_str: return False
        if re.match(r'^```', input_str): return True
        # Single-line strong-bash signal
        if re.search(r'\$\([^)]+\)', input_str) and re.search(r'\b(do|done|then|fi|elif|case|esac)\b', input_str):
            return True
        if input_str.startswith('#!/'): return True
        lines = input_str.split('\n')
        if len(lines) < 3: return False
        code_re = re.compile(
            r'(\b(function|def|class|import|require|const|let|var|return|if|else|elif|for|while|'
            r'try|catch|except|console\.log|print\(|System\.|public|private|static|interface|'
            r'type|enum|fn|impl)\b|[{};]|=>|->|::|\$\(|<<|^\s+\S)',
            re.MULTILINE
        )
        return len(code_re.findall(input_str)) >= 3

    @staticmethod
    def _detect_language(code):
        sigs = {
            'python':     r'^(?:\s*)(?:def |class |from .+ import|import [a-z_]+$|if __name__|@\w+\s*\n\s*def)|:\s*$|\bprint\(|self\.|\bNone\b|\bTrue\b|\bFalse\b|\belif\b',
            'javascript': r'\b(function |const |let |=>|console\.log|require\(|module\.exports|export (?:default |const )|import .* from)\b|;\s*$',
            'typescript': r'\b(interface |type \w+ =|as (?:string|number|boolean|any|unknown)|: (?:string|number|boolean|any|unknown)|enum |readonly )\b',
            'bash':       r'^(?:#!\/bin\/(?:bash|sh|zsh)|set -[a-zeuxo]+|echo |if \[|for \w+ in|fi$|done$|esac$)',
            'java':       r'\b(public class |System\.out\.|String\[\]|public static void)\b',
            'rust':       r'\b(fn \w+|let mut |impl |trait |use std::)\b',
            'go':         r'\b(func \w+|package main|fmt\.Println|interface\{\})\b',
            'sql':        r'\b(SELECT |FROM |WHERE |INSERT INTO|UPDATE |DELETE FROM|CREATE TABLE)\b',
            'html':       r'<\/?(html|head|body|div|span|a|p|h[1-6]|script|style|table|tr|td|ul|li|button|input|form)\b',
            'css':        r'^[\s\w.#-]+\{[^}]*:\s*[^}]+;[^}]*\}',
        }
        best, best_score = None, 0
        for lang, pat in sigs.items():
            flags = re.MULTILINE | (re.IGNORECASE if lang in ('sql','html') else 0)
            score = len(re.findall(pat, code, flags))
            if score > best_score:
                best_score, best = score, lang
        return best if best_score > 0 else None

    @staticmethod
    def _critique_code(code, lang):
        issues = []
        opens = len(re.findall(r'[{(\[]', code))
        closes = len(re.findall(r'[})\]]', code))
        if opens != closes:
            issues.append(f"Unbalanced brackets/braces/parens: {opens} opening vs {closes} closing. Look for a stray `(`, `{{`, or `[` (or a missing closer).")
        for line in code.split('\n'):
            sq = len(re.findall(r"(?<!\\)'", line))
            dq = len(re.findall(r'(?<!\\)"', line))
            if (sq % 2 or dq % 2) and line.strip() and not line.lstrip().startswith(('#','//')):
                issues.append(f"Likely unclosed string on a line: `{line.strip()[:80]}`")
                break
        if lang == 'python':
            if re.search(r'^\t', code, re.M) and re.search(r'^ ', code, re.M):
                issues.append("Mixed tabs and spaces in indentation — Python rejects this. Pick one (PEP 8 recommends 4 spaces).")
            block_re = re.compile(r'^(\s*)(def |if |elif |else|for |while |class |try|except|finally|with |async def )')
            for line in code.split('\n'):
                if block_re.match(line) and not line.rstrip().endswith(':') and not re.search(r'[\\(]$', line.rstrip()):
                    issues.append(f"Missing colon at end of block-opening line: `{line.strip()[:80]}`")
                    break
            if re.search(r'\bprint\s+(?!\()', code) and re.search(r"\bprint\s+['\"]", code):
                issues.append("`print` used without parentheses — that's Python 2 syntax. Use `print(...)` for Python 3.")
            if re.search(r'except\s*:\s*$', code, re.M):
                issues.append("Bare `except:` swallows ALL exceptions, including KeyboardInterrupt and SystemExit. Catch a specific class instead.")
        if lang in ('javascript','typescript'):
            if re.search(r'[^=!]==[^=]', code):
                issues.append("Loose equality (`==`) detected. Prefer `===` for strict comparison — `==` does type coercion (`\"0\" == false` is true).")
            if re.search(r'\bvar\s+\w', code):
                issues.append("Using `var` — prefer `let` (mutable, block-scoped) or `const` (immutable). `var` has function-level scoping that surprises people.")
            if re.search(r'\bawait\b', code) and not re.search(r'\basync\b', code):
                issues.append("Using `await` inside a function that isn't marked `async`. Add `async` to the function declaration.")
        if lang == 'bash':
            if re.search(r'\bif\s+\[\s+\$\w+\s', code):
                issues.append("Unquoted variable in `[ $X ]` — quote it: `[ \"$X\" = \"...\" ]` so empty/whitespace values don't blow up the test.")
            if re.search(r'`[^`]+`', code):
                issues.append("Using backticks for command substitution. Prefer `$(...)` — it nests cleanly and is easier to read.")
            if not re.search(r'set\s+-[eu]', code) and len(code.split('\n')) > 5:
                issues.append("No `set -e` (or `set -euo pipefail`) at the top. Without it, a failing command in the middle of the script is silently ignored.")
            if re.search(r'\bfor\s+\w+\s+in\s+\$\(ls\b', code):
                issues.append("Looping over `$(ls)` is fragile (breaks on spaces/newlines in filenames). Use globs: `for f in *.txt; do ...; done`.")
        return issues

    def _format_code_critique(self, lang, issues):
        tag = lang.capitalize() if lang else 'Code'
        if not issues:
            return f"{tag} block detected. I scanned it for common patterns and didn't spot anything obvious — but I only do pattern checks, not real parsing. Want me to look at a specific error message? 🐒"
        body = "\n".join('• ' + s for s in issues)
        return f"{tag} block detected. A few things I noticed:\n\n{body}\n\nThese are pattern-based hints, not a real parser — your tooling will catch more. 🐒"

    def handle_coding_input(self, user_input, lower):
        """Run the coding dispatchers in order: error > code paste > debugging > recipe."""
        if len(user_input) > 8:
            hit = self._detect_error_pattern(user_input)
            if hit: return self._format_error_response(hit)
        if self._looks_like_code(user_input):
            lang = self._detect_language(user_input)
            issues = self._critique_code(user_input, lang)
            return self._format_code_critique(lang, issues)
        guides = (self.debugging or {}).get('guides') or []
        guide = self._find_by_triggers(guides, lower, min_score=2)
        if guide: return self._format_guide(guide)
        recipes = (self.recipes or {}).get('recipes') or []
        recipe = self._find_by_triggers(recipes, lower, min_score=1)
        if recipe: return self._format_recipe(recipe)
        return None

    def strip_question(self, q: str) -> str:
        """Remove filler phrases from question."""
        # Preserve important phrases
        preserve_phrases = ['new repo', 'new repository']
        if any(phrase in q.lower() for phrase in preserve_phrases):
            # Only strip leading question words, not the content
            result = re.sub(r'^(what is |what are |how do i |can you |could you |do you )', '', q, flags=re.IGNORECASE)
            return result.strip()

        patterns = [
            (r'^(please |can you |could you |can you tell me|could you tell me|do you (?:know |happen to know|know anything about)|tell me |i (?:want to know|was wondering|wonder|was just wondering|\'m curious about)|help me understand |explain to me )', ''),
            (r'^(what (?:is|are|was|were|\'s|does|do|did|can|makes|causes|happens|kind of|type of|sort of|\'s the deal with|\'s up with))', ''),
            (r'^(who (?:is|are|was|were|\'s|invented|created|discovered|made|built|founded))', ''),
            (r'^(how (?:does|do|did|is|are|was|were|to|many|much|long|big|large|small|fast|old|far))', ''),
            (r'^(why (?:does|do|did|is|are|was|were|can\'t|cant|would))', ''),
            (r'^(where (?:is|are|was|were|do|does|did|can))', ''),
            (r'^(when (?:is|was|were|did|does|do))', ''),
            (r'^(is (?:it|there|a|an)|are (?:there|they)|does it|do they|did it|can (?:it|they)|will it|have you heard of|do you know (?:what|about))', ''),
            (r'^(tell me about|talk to me about|give me (?:info on|information about|some info on|facts about)|info (?:on|about)|information (?:on|about)|facts about|fact about|about)', ''),
            (r'^(i want to learn about|explain|describe|define|what does.*mean)', ''),
            (r'\?+$', ''),
            (r'^(the |a |an )', ''),
        ]
        result = q
        for pattern, replacement in patterns:
            result = re.sub(pattern, replacement, result, flags=re.IGNORECASE)
        return result.strip()

