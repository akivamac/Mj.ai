def fetch_backside_facts(api_key):
    ctx = ssl.create_default_context()
    req = urllib.request.Request(
        'https://api.worktruck.app/api/v1/notes?tag=monkey-joe-brain&limit=1000',
        headers={
            'Authorization': f'Bearer {api_key}',
            'Content-Type': 'application/json',
            'User-Agent': 'Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36',
            'Accept': 'application/json, text/plain, */*',
            'Accept-Language': 'en-US,en;q=0.9',
        }
    )
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            data = json.loads(resp.read())
            facts = []
            for note in data.get('notes', []):
                keywords = [k.strip() for k in note['title'].split(',')]
                facts.append({'keywords': keywords, 'answer': note['body']})
            return facts
    except Exception:
        return []

def ask_haiku(question, api_key):
    """Ask Haiku and get both an answer and a brain fact to save."""
    prompt = f"""You are helping Monkey Joe — a rules-based AI assistant — learn new facts.

A user asked: "{question}"

Respond with ONLY a JSON object (no markdown, no explanation) in this exact format:
{{
  "answer": "A clear, helpful answer in 2-4 sentences. Be friendly and informative. End with nothing extra.",
  "keywords": ["keyword1", "keyword2", "keyword3", "keyword4", "keyword5"]
}}

Rules for keywords:
- 3-8 keywords that someone would use to ask this question
- Use lowercase, specific phrases (2-4 words each preferred)
- Include the main topic, synonyms, and related phrasings
- Never use single letters or 2-letter abbreviations as standalone keywords
- Example for "what is photosynthesis": ["photosynthesis", "how plants make food", "chlorophyll process", "plant energy", "how do plants grow"]

Rules for the answer:
- 2-5 sentences maximum
- Friendly, informative tone
- No markdown formatting
- End with a period"""

    payload = json.dumps({
        "model": "claude-haiku-4-5-20251001",
        "max_tokens": 400,
        "messages": [{"role": "user", "content": prompt}]
    }).encode()

    req = urllib.request.Request(
        'https://api.anthropic.com/v1/messages',
        data=payload,
        headers={
            'x-api-key': api_key,
            'anthropic-version': '2023-06-01',
            'content-type': 'application/json'
        }
    )

    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            data = json.loads(resp.read())
            text = data['content'][0]['text'].strip()
            text = text.replace('```json', '').replace('```', '').strip()
            return json.loads(text)
    except Exception:
        return None

def push_file_to_github(path, content, message, token):
    """Push a single file to GitHub."""
    import base64
    REPO = 'akivamac/Mj.ai'
    BRANCH = 'main'
    BASE = 'https://api.github.com'
    headers = {
        'Authorization': f'token {token}',
        'Content-Type': 'application/json',
        'Accept': 'application/vnd.github+json',
    }
    ctx = ssl.create_default_context()
    try:
        req = urllib.request.Request(
            f'{BASE}/repos/{REPO}/contents/{path}?ref={BRANCH}',
            headers=headers
        )
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            sha = json.loads(resp.read())['sha']
    except Exception:
        sha = None
    body = {
        'message': message,
        'content': base64.b64encode(content.encode()).decode(),
        'branch': BRANCH,
    }
    if sha:
        body['sha'] = sha
    try:
        req = urllib.request.Request(
            f'{BASE}/repos/{REPO}/contents/{path}',
            data=json.dumps(body).encode(),
            headers=headers,
            method='PUT'
        )
        with urllib.request.urlopen(req, context=ctx, timeout=15) as resp:
            return resp.status in (200, 201)
    except Exception:
        return False

def learn_and_save(fact, brain_dir, github_token):
    """Save new fact to knowledge.json and push to GitHub."""
    knowledge_path = os.path.join(brain_dir, 'knowledge.json')
    try:
        with open(knowledge_path, 'r') as f:
            data = json.load(f)
    except Exception:
        data = {"facts": []}
    existing_keywords = set()
    for existing in data['facts']:
        for kw in existing.get('keywords', []):
            existing_keywords.add(kw.lower())
    new_keywords = [k for k in fact['keywords'] if k.lower() not in existing_keywords]
    if not new_keywords:
        return False
    data['facts'].append({"keywords": fact['keywords'], "answer": fact['answer']})
    with open(knowledge_path, 'w') as f:
        json.dump(data, f, indent=2)
    if github_token:
        push_file_to_github(
            'brain/knowledge.json',
            open(knowledge_path).read(),
            f'brain: Joe learned "{fact["keywords"][0]}" from Haiku',
            github_token
        )
    return True

def is_statement_about_joe(text: str) -> bool:
    """Return True if the input is a statement directed at Joe, not a question."""
    lower = text.lower().strip()
    statement_patterns = [
        'you are', 'you were', 'you will', 'you have', 'you look',
        'you seem', 'you sound', 'you feel', 'you act', 'you work',
        'it is', "it isn't", 'it is not', 'this is', 'that is',
        'i think', 'i believe', 'i feel', 'i know', 'i see',
        'i notice', 'i found', 'i found out', 'i realized',
    ]
    question_starters = ['what', 'why', 'how', 'where', 'when', 'who', 'which',
                         'can ', 'do ', 'does ', 'is ', 'are ', 'was ', 'will ',
                         'would ', 'could ', 'should ']
    has_question = any(lower.startswith(q) for q in question_starters) or lower.endswith('?')
    if has_question:
        return False
    return any(lower.startswith(p) for p in statement_patterns)

