def log_file(filepath):
    """Track created files in ~/.mj_files.json"""
    try:
        files = json.loads(open(FILES_LOG).read()) if os.path.exists(FILES_LOG) else []
    except:
        files = []
    abs_path = os.path.abspath(filepath)
    if abs_path not in files:
        files.append(abs_path)
    with open(FILES_LOG, 'w') as f:
        json.dump(files, f)

