    def _get_intent(self, q):
        # Disambiguate "how long do they LIVE" (lifespan) from "how long IS it"
        # (size) — bare "long" lives in the size list and would otherwise win.
        if re.search(r'\bhow long\b', q) and re.search(r'\b(live|lives|living|life|last|survive)\b', q):
            return self._INTENT_MAP['lifespan']
        for intent, words in self._INTENT_MAP.items():
            for w in words:
                if w in q:
                    return words
        return None

    @staticmethod
    def _extract_focused(answer, intent_words):
        """Return just the sentence(s) relevant to a sub-topic intent, or
        None. Word-boundary match so 'hunt' doesn't hit 'hunting'. (Bug 3)"""
        sentences = [s.strip() for s in re.split(r'(?<=[.!?])\s+', answer) if s.strip()]
        if len(sentences) <= 2:
            return None
        hits = []
        for s in sentences:
            sl = s.lower()
            if any(re.search(r'\b' + re.escape(w) + r'\b', sl) for w in intent_words):
                hits.append(s)
        if not hits or len(hits) > (len(sentences) + 1) // 2:
            return None
        return ' '.join(hits)

    @staticmethod
    def _detect_category_q(q):
        """'is there a <category> called <name>' / 'is a <name> a <category>'."""
        m = re.search(r'\bis\s+there\s+(?:a|an)\s+([a-z]+)\s+(?:called|named)\s+(?:a |an |the )?([a-z]+)', q, re.I)
        if m:
            return {'category': m.group(1), 'name': m.group(2)}
        m = re.search(r'\bis\s+(?:a |an |the )?([a-z]+)\s+(?:a|an)\s+(?:kind\s+of\s+|type\s+of\s+|sort\s+of\s+|species\s+of\s+)?([a-z]+)\b', q, re.I)
        if m:
            return {'category': m.group(2), 'name': m.group(1)}
        return None

    def apply_contextual_followup(self, q: str) -> str:
        """Append last topic ONLY when the input looks like a follow-up — an
        explicit connector or a bare 1-2 word noun phrase. The old "any
        ≤3-word non-question" rule glued the prior topic onto unrelated
        remarks ("you like bananas" → "...masseter", "you loco" →
        "...potassium"). (v78, Bug B)"""
        if not self.last_topic_label:
            return q
        if self.last_topic_label in q:
            return q
        # Pronoun / starter follow-up ("what do they eat", "and the babies",
        # "how about color") → append the topic for the scorer. Mirrors the web
        # detectFollowUp; only used for the knowledge lookup. (v82 parity)
        pronoun = ['they ', 'their ', 'them ', 'it ', 'its ', 'the animal', 'the creature', 'those animals', 'that animal']
        starter = ['and ', 'also ', 'but what', 'what about ', 'how about ', 'tell me more', 'more about', 'what else', 'same with', 'what do they', 'how do they', 'where do they', 'can they', 'do they ']
        if any(p in q for p in pronoun) or any(q.startswith(s) for s in starter):
            return q + ' ' + self.last_topic_label
        words = q.strip().split()
        if len(words) <= 2 and not re.match(
                r"^(you|u|i|we|it|he|she|they|me|my|your|do|does|are|is|am|was|were|the|a|an|no|yes|ok|okay|cool|nice|hi|hey|hello|yo|sup|loco|crazy|nuts|stop|why|how|what|who|when|where)\b", q):
            return q + ' ' + self.last_topic_label
        return q

    def is_casual_statement(self, text: str) -> bool:
        """Check if input is a casual statement, not a question."""
        lower = text.lower().strip()
        # Must have no question words and not end with question mark
        question_starters = ['what', 'why', 'how', 'where', 'when', 'who', 'which',
                            'can ', 'do ', 'does ', 'is ', 'are ', 'was ', 'were ',
                            'will ', 'would ', 'could ', 'should ', 'tell me', 'explain', 'define']
        has_question = any(lower.startswith(q) for q in question_starters) or lower.endswith('?')
        if has_question:
            return False
        # Check for casual/opinion words. Synced to the web list (v82): dropped
        # 'like'/'ok' (too greedy), added funny/weird/agree/i guess/i bet/etc.,
        # and require >= 4 words so short inputs don't false-trigger.
        casual_words = ['cool', 'awesome', 'nice', 'great', 'love', 'hate', 'think', 'feel',
                       'wow', 'lol', 'haha', 'interesting', 'yeah', 'yep', 'nope',
                       'okay', 'sure', 'thanks', 'thank you', 'no way', 'really', 'seriously',
                       'funny', 'weird', 'agree', 'i guess', 'i bet', 'gonna tell', 'tell on you']
        if len(lower.split()) >= 4 and any(w in lower for w in casual_words):
            return True
        # Conversational remark aimed AT Joe — "you are being crazy", "you're
        # funny", "i was just saying hi", "stop it", "that's silly". Must never
        # reach the knowledge scorer (where it dumped a random fact). (v76)
        return bool(
            re.match(r"^(you'?re|you are|you look|you seem|you sound|you keep|you always|you never|ur)\b", lower)
            # Verbless slang aimed at Joe — "you loco", "you crazy", "you nuts". (v78 Bug B)
            or re.match(r"^(you|u|ur|yall|y'all)\s+(so\s+|real\s+|kinda\s+|pretty\s+)?(loco|crazy|nuts|silly|wild|funny|weird|goofy|wack|wacky|bananas|bonkers|insane|ridiculous|cray|cray cray|dumb|smart|cool|hilarious)\b", lower)
            or re.match(r"^i('?m| am| was)\s+(just\s+|only\s+)?(saying|sayin|joking|jokin|kidding|kiddin|chatting|chattin|talking|talkin|messing|messin|playing|playin|teasing|teasin|testing|goofing|trolling)\b", lower)
            or re.match(r"^(stop|quit|cut it out|chill|relax|calm down|knock it off|be quiet|shush|hush)\b", lower)
            or re.match(r"^(that'?s|thats|that is|this is|this'?s|it'?s|its|it is)\s+(so |really |very |kinda |kind of |pretty |super |a bit )?(crazy|silly|funny|weird|wrong|random|nonsense|nuts|wild|insane|ridiculous|bananas|goofy|odd|strange)\b", lower)
        )

    def _handle_memory_command(self, user_input, lower):
        """Memory command dispatcher — mirror of handleMemoryCommand in
        brain.js. Returns string or None."""
        trimmed = re.sub(r'[?.!]+$', '', user_input.strip())
        # Forget-everything confirmation
        if self._forget_everything_pending:
            self._forget_everything_pending = False
            if re.match(r'^(yes|yep|yeah|sure|confirm|do it|forget everything|yes,? forget everything)\b', trimmed, re.I):
                self.memory.clear()
                return "Done — fresh slate. I've cleared everything I knew. 🐒"
            return "OK, I won't forget anything. What else?"
        if re.match(r'^forget\s+(everything|all|all of it|me|what you know)\b', trimmed, re.I):
            self._forget_everything_pending = True
            n = len(self.memory.list_facts())
            return (f"Want me to wipe everything I remember ({n} fact{'' if n == 1 else 's'} you "
                    f"told me, plus all the conversation patterns I've tracked)? Say \"yes\" to confirm.")
        # Forget a single fact
        m = re.match(r'^forget\s+(?:about\s+)?(?:my\s+)?(.+)$', trimmed, re.I)
        if m:
            r = self.memory.forget_fact(m.group(1))
            return (f"Forgotten. I no longer know your {m.group(1)}. 🐒" if r['removed']
                    else f"I didn't have anything stored under \"{m.group(1)}\".")
        # Recall — full list
        if re.match(r'^(what\s+do\s+you\s+(?:know|remember)(?:\s+about\s+me)?|tell\s+me\s+what\s+you\s+(?:know|remember)(?:\s+about\s+me)?|list\s+(?:your\s+)?memor(?:y|ies)|show\s+(?:your\s+)?memor(?:y|ies))$', trimmed, re.I):
            return self.memory.summary()
        # Recall — specific subject
        m = re.match(r"^(?:do\s+you\s+(?:remember|know)\s+(?:about\s+)?(?:my\s+)?(.+)|what(?:'s|\s+is)\s+my\s+(.+))$", trimmed, re.I)
        if m:
            subj = m.group(1) or m.group(2)
            v = self.memory.get_fact(subj)
            return (f"Yes — you told me your {subj} is {v}. 🐒" if v
                    else f"I don't know your {subj} yet — tell me with \"remember that my {subj} is …\" and I'll keep it safe.")
        # Store — "remember that my X is Y"
        m = re.match(r'^(?:please\s+)?remember\s+(?:that\s+)?my\s+(.+?)\s+(?:is|=)\s+(.+)$', trimmed, re.I)
        if m:
            r = self.memory.set_fact(m.group(1), m.group(2))
            if r.get('rejected'):
                return "I don't store things like passwords or addresses — just names, favorites, that kind of thing. 🐒"
            return f"Got it — your {m.group(1)} is {m.group(2)}. I'll remember. 🐒"
        # Store — "remember that I love/like X"
        m = re.match(r'^(?:please\s+)?remember\s+(?:that\s+)?i\s+(?:love|like|enjoy|am into|am)\s+(.+)$', trimmed, re.I)
        if m:
            existing = self.memory.get_fact('about_me')
            nxt = (existing + ', ' + m.group(1)) if existing else m.group(1)
            r = self.memory.set_fact('about_me', nxt)
            if r.get('rejected'):
                return "Try something specific — like 'remember that I love dragons'!"
            return f"Locked in — you like {m.group(1)}. 🐒"
        # Store — "remember this for later: X" / "make a note that X"
        m = re.match(r"^(?:remember\s+this(?:\s+for\s+later)?[:,]?\s*|make\s+a\s+note(?:\s+that)?\s+|don'?t\s+forget(?:\s+that)?\s+)(.+)$", trimmed, re.I)
        if m:
            r = self.memory.set_fact('note_' + str(int(time.time()))[-6:], m.group(1))
            if r.get('rejected'):
                return "I don't store things like passwords or addresses."
            return f"Noted: \"{m.group(1)}\". 🐒"
        return None

    def respond(self, user_input: str) -> str:
        """Generate response using brain knowledge."""
        lower = user_input.lower().strip()
        if not lower:
            return ""

        # Memory commands win early.
        mem = self._handle_memory_command(user_input, lower)
        if mem is not None: return mem

        # Tick flavoring counters (Phase 3) once per respond() call.
        self._recent_flavor_age += 1
        self._story_hook_age    += 1
        self._last_math_age     += 1

        # Story-hook reply — short affirmative within 2 turns of a hook
        # triggers a fact-woven story on the hooked subject.
        if self._is_story_hook_yes(lower):
            subj = self._story_hook_subject
            kws  = self._story_hook_keywords or []
            self._story_hook_subject = None
            self._story_hook_age = 99
            all_facts = list(self.knowledge or []) + list(self.coding or [])
            fact = next((f for f in all_facts
                         if f.get('keywords')
                         and any(k in f['keywords'] for k in kws)), None)
            r = self.generate_story({
                'subject': subj, 'fact': fact.get('answer') if fact else None,
                'tone': None, 'mode': 'regular'
            })
            self.story_session = {
                'tone': r.get('tone'), 'subject': subj,
                'character': r.get('character'), 'place': r.get('place'),
                'chapter': 1, 'chapterMode': False, 'mode': 'regular'
            }
            return r.get('text', '')

        # How are you — must be first, before ANY knowledge lookup
        how_are_you = ['how are you', 'how are u', 'how do you feel', 'you okay', 'you good',
                       'hows it going', "how's it going", 'how you doing', 'how you doin', "how're you"]
        if any(p in lower for p in how_are_you):
            return random.choice([
                "Doing great, thanks for asking! What can I help you with? 🐒",
                "Pretty good! Ready to answer your questions. What's up?",
                "Living my best rules-based life! What do you need?",
                "Can't complain — no feelings to complain with! 😄 What's on your mind?",
                "Fully operational and caffeinated on data. You?",
            ])

        # Relational + affection (v60 parity with brain.js). Answer warmly
        # instead of letting "do you love me" fall into the knowledge scorer,
        # and acknowledge affection while still answering a bundled question
        # ("I love you, what's your name?").
        ask_name  = bool(re.search(r"\b(what'?s|what is|whats)\s+your\s+name\b|\bwho\s+(are|r)\s+(you|u)\b|\bwhat\s+are\s+you(\s+called)?\b", lower))
        aff_lead  = bool(re.search(r'\bi\s+(love|like)\s+(you|u|ya)\b', lower))
        loves_me  = (bool(re.search(r'\bdo\s+you\s+(really\s+|even\s+|still\s+)?love\s+me\b', lower))
                     or bool(re.search(r"\byou\s+(don'?t|do\s+not|dont)\s+love\s+me\b", lower))
                     or bool(re.search(r'\bdo\s+you\s+(really\s+|even\s+)?like\s+me\b', lower)))
        friend_me = (bool(re.search(r'\b(are|will|would)\s+you\s+(be\s+|become\s+)?my\s+friend\b', lower))
                     or bool(re.search(r'\bare\s+we\s+(friends|buddies|pals)\b', lower))
                     or bool(re.search(r'\bdo\s+you\s+care\s+(about\s+)?me\b', lower)))
        if loves_me or friend_me:
            return random.choice([
                "Of course I do! 🐒❤️ You're my favorite human to chat with.",
                "You bet I do! 🐒 I'm always happy when you show up.",
                "Always! 🐒❤️ You and me — best buddies.",
                "100%! 🐒 I light right up every time you say hi."])
        if aff_lead and ask_name:
            return "Aw 🐒❤️ I love chatting with you too! And I'm Monkey Joe — a rules-based assistant built by Akiva with Claude's help. 🐒"
        if aff_lead:
            return random.choice([
                "Aw 🐒❤️ You're the best!",
                "I like you too! 🐒",
                "🐒❤️ Right back at you, friend!"])

        # R4a (v79): "what do monkeys eat" — Joe IS a monkey.
        if re.match(r"^(?:so[, ]+)?(?:what|which)\s+do\s+(monkeys|apes)\s+(eat|drink|like)\b", lower):
            return random.choice([
                "We monkeys munch fruit, leaves, seeds, nuts, and bugs 🐒 — but let's be honest, it's mostly bananas 🍌",
                "Fruit, nuts, leaves, the odd insect… and BANANAS 🍌🐒 Always bananas.",
                "Speaking as a monkey: bananas first, then whatever fruit's in reach 🍌🐒"])
        # R7 (v79): compliments aimed at Joe → say thanks in character.
        if (re.search(r"\b(you'?re|you are|youre|ur|yer)\s+(so\s+|really\s+|very\s+|super\s+|pretty\s+|such\s+a\s+|a\s+)?(cute|adorable|sweet|lovely|nice|kind|awesome|amazing|wonderful|the\s+best|best|great|funny|hilarious|smart|clever|cool|good|fun|cutest|precious|charming)\b", lower)
                and not lower.rstrip().endswith('?')):
            return random.choice([
                "Aw, thanks! 🐒💛 You're pretty great yourself.",
                "Stop it, you 🙈🐒 (don't stop, actually). Thank you!",
                "🐒💛 That made my whole jungle day. What can I do for you?",
                "Thanks! I try 🐒 Now — what's on your mind?"])

        # Persona: Joe's own tastes/behavior — "do you like bananas", "you like
        # bananas", "do you bite", "your favorite food". Answer in character
        # instead of dumping a keyword fact (bananas→potassium, bite→masseter).
        # (v78, Bugs A/C)
        pm = (re.match(r"^(?:so[, ]+)?do(?:es)?\s+(?:you|u|ya)\s+(like|love|enjoy|eat|prefer|hate|bite|scratch|kick|chase|fancy|dig)\b\s*(.*)$", lower)
              or re.match(r"^(?:so[, ]+)?(?:what|which)\s+do(?:es)?\s+(?:you|u|ya)\s+(like|love|enjoy|eat|drink|prefer|hate|fancy|dig)\b\s*(.*)$", lower)
              or re.match(r"^(?:you|u)\s+(like|love|enjoy|eat|prefer|hate|bite|scratch|kick|chase|fancy|dig)\s+(.+)$", lower))
        if pm:
            verb = pm.group(1)
            obj = re.sub(r'[?.!]+$', '', pm.group(2) or '')
            obj = re.sub(r'^(to |a |an |the |some |any |my )', '', obj).strip()
            if re.search(r'\bbanana', lower):
                return random.choice([
                    "Bananas?! 🍌 I'm a monkey — I'd eat them all day. Hands-down favorite.",
                    "Do I like bananas?? 🐒🍌 Is the jungle green? I LOVE them.",
                    "Bananas are basically my whole personality 🍌 Best snack in the canopy."])
            if verb in ('bite', 'scratch', 'kick', 'chase'):
                return random.choice([
                    "Haha, nah — I'm a friendly monkey, all chatter and no bite. 🐒 I'd rather split a banana!",
                    "Me? Bite? 🙈 Never. I'm a lover, not a biter — bananas only.",
                    "Nope, totally gentle here 🐒 The most dangerous thing I do is steal bananas."])
            if verb == 'hate':
                return random.choice([
                    "I try not to hate anything — except maybe an empty banana peel. 🐒",
                    "Hate's a strong word! I'm a pretty chill monkey 🍌 What's up?"])
            if verb == 'eat':
                return random.choice([
                    "Mostly bananas 🍌 — I'm a monkey, after all! Fruit, nuts, and a good story for dessert.",
                    "Bananas, bananas, and more bananas 🍌 Maybe a mango when I'm feeling fancy."])
            return random.choice([
                (obj[0].upper() + obj[1:] + '? ' if obj else '') + "I'm a banana monkey at heart 🍌, but I'm easy to please. What about you?",
                "I'm pretty into bananas, naps, and a good story 🐒 What's your favorite?",
                "If it's a snack, I'm probably a fan 🍌 Bananas first, always."])
        if re.search(r'\byour\s+favou?rite\b', lower):
            return random.choice([
                "Bananas. No contest. 🍌🐒",
                "Easy — bananas! 🍌 (and banana-yellow, if we're picking colors.)",
                "My favorite anything? Usually bananas 🍌 What's yours?"])

        # R1 (v79): "are you <state>" about Joe → playful reply, not a fact.
        state_m = re.match(r"^(?:so[, ]+)?(?:are|r)\s+(?:you|u|ya)\s+(?:really\s+|even\s+|still\s+|so\s+|getting\s+|feeling\s+|a\s+little\s+|a\s+bit\s+|kinda\s+|kind\s+of\s+)?([a-z][a-z' ]*?)[\s?.!]*$", lower)
        # Bail on action requests ("are you going to help me", "are you able to
        # draw") — don't answer those as a mood. (v82 audit fix)
        if state_m and re.search(r'\b(going to|gonna|able to|free to|willing to|planning to|trying to|allowed to|supposed to|going)\b', state_m.group(1)):
            state_m = None
        if state_m:
            st = state_m.group(1).strip()
            if re.search(r'\b(excited|pumped|thrilled|happy|glad|ready|hyped|stoked)\b', st):
                return random.choice(["Always a little excited to chat with you! 🐒", "You bet — ready and bouncing 🐒🍌 What's up?"])
            if re.search(r'\b(riled|mad|angry|upset|grumpy|annoyed|cranky|frustrated)\b', st):
                return random.choice(["Nah, I'm chill 🐒 Takes a LOT to rile a monkey. What's going on?", "Not at all! Cool as a cucumber over here 🐒 (a banana-shaped one)."])
            if re.search(r'\b(tired|sleepy|bored|busy)\b', st):
                return "Never too tired for you! 🐒 What do you need?"
            if re.search(r'\b(real|alive|a robot|a bot|human|fake)\b', st):
                return random.choice(["Real enough to chat with you! 🐒 I'm a friendly bundle of rules and bananas Akiva built.", "I'm a real friendly monkey in here! 🐒 Real enough to brighten your day, anyway."])
            if re.search(r'\b(crazy|loco|nuts|silly|wild|goofy|wacky|bananas|bonkers|insane)\b', st):
                return random.choice(["A little! 🐒 Goofy's kind of my whole brand. 🍌", "Guilty 🙈🐒 A wild monkey's gotta be a little loco. What's up?"])
            if re.search(r'\b(hungry|starving|peckish)\b', st):
                return "Always — got a banana? 🍌🐒"
            if re.search(r'\b(ai|a\.i\.|an ai|llm|chatgpt|gpt|a bot|a robot|a program|a computer)\b', st):
                return "I'm a rules-based program (not a big AI like Claude or ChatGPT) 🐒 — I match patterns in what you say. Built by Akiva with Claude's help."
            if re.search(r'\b(boy|girl|man|woman|male|female|he or she|a boy or)\b', st):
                return "I'm just a monkey — no boy or girl here, only bananas! 🐒 Call me 'he' or 'they', whatever you like."
            if re.search(r'\b(ok|okay|alright|good|fine|well|sure|doing (ok|good|well|fine))\b', st):
                return "I'm great, thanks for asking! 🐒 How are YOU?"
            return random.choice(["Me? Just a happy monkey here to help 🐒 What's on your mind?", "Could be! 🐒 Hard to say — I'm mostly bananas and good intentions. What's up?"])

        # R2 (v79): requests for Joe to DO a real-world task → he can't (no
        # hands!). Gated on food/chore words so "make me a story" still works.
        if ((re.search(r"\b(cook|bake|fry|boil|grill|microwave|heat\s*up|reheat|make|fix|get|bring|fetch|prepare|whip\s*up|warm\s*up|serve)\b", lower)
                and re.search(r"\b(egg|eggs|breakfast|brunch|lunch|dinner|supper|meal|food|toast|coffee|tea|sandwich|snack|pancakes?|bacon|soup|rice|dish|dishes|nuggets?)\b", lower))
            or re.search(r"\b(clean|wash|vacuum|mop|sweep|fold|iron|dust|scrub|tidy|do)\b\s+(my|the|up|some)\b.*\b(room|dishes|laundry|clothes|floor|house|mess|bed|car)\b", lower)):
            return random.choice([
                "Haha, I'd love to — but I'm a monkey in a screen, no hands and definitely no kitchen 🐒 I can hand you a recipe, a story, or some math though! 🍌",
                "If only! 🙈 I'm all paws and pixels in here. Can't cook, but I'll happily tell you HOW, or spin you a story while you do. 🐒",
                "No can do — I'd just get banana all over everything 🍌🐒 Want the recipe or a fun fact instead?"])

        # Identity questions about Joe (v93) — answer in character.
        if re.search(r"\bhow old are (you|u)\b|\bwhat'?s your age\b|\bwhen were you (born|made|created)\b", lower):
            return "I'm a young monkey in computer years! 🐒 No real birthday — Akiva and Claude just keep growing my brain bit by bit."
        if re.search(r"\bwhere do (you|u) live\b|\bwhere are (you|u)( from)?\b|\bwhere do (you|u) come from\b", lower):
            return "I live right here in this app — a cozy little jungle of code! 🐒 (Built by Akiva.)"
        if re.search(r"\bwho (made|created|built|coded|designed|programmed|owns) (you|u)\b|\bwho'?s your (creator|maker|owner|boss|developer)\b", lower):
            return "Akiva built me, with a lot of help from Claude (an AI)! 🐒 I'm Monkey Joe."
        if re.search(r"\bhow (were|are) (you|u) (made|built|created)\b", lower):
            return "I'm a rules-based program (not a big AI like Claude or ChatGPT) 🐒 — I match patterns in what you say and pick a reply, backed by a huge brain of facts Akiva and Claude filled in."
        if re.search(r"^(what'?s|what is|whats)\s+your\s+name\b|^who\s+(are|r)\s+(you|u)\b|^what\s+are\s+(you|u)\b|^what\s+should\s+i\s+call\s+you\b", lower):
            return "I'm Monkey Joe! 🐒 A friendly rules-based chatbot made by Akiva. Ask me facts, math, science, stories, jokes — you name it. 🍌"
        # Time/date — no clock/calendar (v94)
        if re.search(r"\bwhat (time|day|date|year|month) is it\b|\bwhat'?s the (time|date|day)\b|\bwhat day of the week\b|\btoday'?s date\b|\bdo you know (what time|the time|the date)\b|\bwhat is the (time|date)\b", lower):
            return "I don't have a clock or calendar here in my jungle 🐒 — peek at the corner of your device, it always knows! ⏰"
        # Drawing (v98) — CLI can't draw or show a pad
        if re.search(r"^(can|could|will|would)\s+(you|u)\s+draw\b|^draw\s+(me\s+)?(a|an|some|the)?\s*\w+|^(make|draw|create)\s+(me\s+)?a\s+(picture|drawing|painting|sketch)\b|^draw something\b|\bdraw me\b", lower):
            return "I can't draw with these monkey paws 🐒 — but I can describe one, spin a story about it, or tell you fun facts! 🍌"
        # Capability / self-intro (v98)
        if re.search(r"^(tell me about (yourself|you)|introduce yourself|who are you again|what'?s your (deal|story))\b", lower):
            return "I'm Monkey Joe! 🐒 A rules-based chatbot Akiva built. I can answer facts, do math & science, spin stories, tell jokes & riddles, play word games, count, and flip coins. What sounds fun? 🍌"

        # Jokes (v86). "knock knock" plays along.
        if re.match(r'^\s*knock[\s,]+knock\b', lower):
            return "Who's there? 🐒"
        _is_def_q = re.match(r"^(what|what'?s|whats|what\s+are|what're|define|the meaning of|meaning of)\b", lower)
        if (not _is_def_q
                and re.search(r'\b(tell|know|got|hear|heard|another|more|say|share)\b.*\bjoke|\bjokes?\b\s*(please|joe)?[\s!.?]*$|^(make me laugh|something funny|say something funny|be funny)', lower)
                and not re.search(r'why did|what do you call|knock knock', lower)):
            return random.choice(self._JOKES)
        if not _is_def_q and re.search(r'\briddle\b|^(riddle me this|stump me|give me a brain teaser|brain teaser)', lower):
            return random.choice(self._RIDDLES)
        # Wordplay: opposite / synonym (v91)
        opp_m = re.search(r'(?:what\'?s|what is|whats|name|tell me)?\s*(?:the\s+)?opposite of\s+([a-z]+)|antonym (?:of|for)\s+([a-z]+)', lower)
        if opp_m:
            w = opp_m.group(1) or opp_m.group(2)
            ant = self._ANTONYMS.get(w) or next((k for k, v in self._ANTONYMS.items() if v == w), None)
            return f'The opposite of \"{w}\" is {ant}! 🐒' if ant else f'Hmm, I don\'t have a good opposite for \"{w}\" 🐒'
        syn_m = re.search(r'(?:another word for|other words for|synonyms? (?:of|for)|words? (?:like|similar to)|what\'?s another way to say)\s+([a-z]+)', lower)
        if syn_m:
            w = syn_m.group(1); syns = self._SYNONYMS.get(w)
            return f'A few words like \"{w}\": {", ".join(syns[:4])} 🐒' if syns else f'Hmm, I can\'t think of a good synonym for \"{w}\" right now 🐒'

        # Fun utilities (v97): coin flip, dice, random number
        if re.search(r'\b(flip|toss)\s+(a\s+|the\s+)?coin\b|\bcoin\s+(flip|toss)\b|^heads or tails\b', lower):
            return "🪙 Heads!" if random.randint(0, 1) else "🪙 Tails!"
        if re.search(r'\broll\s+(a\s+|the\s+|some\s+|two\s+|2\s+)?(dice|die|d6)\b|\bdice roll\b|^roll\b', lower):
            if re.search(r'\b(two|2)\b', lower):
                x, y = random.randint(1, 6), random.randint(1, 6)
                return f"🎲🎲 You rolled {x} and {y} — that's {x + y}!"
            return f"🎲 You rolled a {random.randint(1, 6)}!"
        if re.search(r'\b(pick|choose|think of|give me|generate|gimme)\b.*\bnumber\b|\brandom number\b', lower):
            rm = re.search(r'(?:between|from)\s+(-?\d+)\s+(?:and|to)\s+(-?\d+)', lower)
            lo, hi = (1, 100)
            if rm:
                lo, hi = int(rm.group(1)), int(rm.group(2))
                if lo > hi: lo, hi = hi, lo
            return f"🐒 How about... {random.randint(lo, hi)}!"

        # Empathy + common-kid conversational gaps (v86).
        if re.search(r"^(i'?m|i am|im|feeling|feel|so|really|getting)\b.*\bbored\b|^bored\b", lower):
            return random.choice(["Let's fix that! 🐒 Want a story, a fun fact, a joke, or some math?",
                "Boredom? Not on my watch 🍌 I can tell you a joke, spin a story, or hit you with a wild fact — pick one!"])
        if re.search(r"\b(bad|rough|terrible|awful|horrible|worst)\s+day\b|^(i'?m|i am|im|feeling|feel)\s+(sad|down|upset|unhappy|blue|low|lonely)\b", lower):
            return random.choice(["Aw, I'm sorry to hear that 🐒💛 Want a joke to lift the mood, or a cozy story?",
                "That's rough — sending you a banana and a hug 🍌🤗 Want me to cheer you up with a joke or a fun fact?"])
        if re.search(r"\b(scared|afraid|frightened|nervous|anxious|worried)\b", lower) and re.match(r"^(i|im|i'?m|feeling|feel)\b", lower):
            return random.choice(["It's totally okay to feel that way 🐒 Want a cozy story or a fun fact to take your mind off it?",
                "Deep breath — you've got this 🐒💛 I can keep you company with a story or a silly joke if you'd like."])
        if re.search(r"\b(help|with)\b.*\bhomework\b|^help me (study|learn)\b", lower):
            return "Sure, happy to help! 🐒 I'm best at math, science, and facts — what's the subject or question?"
        if re.match(r"^(sing|can you sing|will you sing)\b", lower):
            return "Monkeys aren't exactly songbirds 🙈🐒 — but I can spin you a story, tell a joke, or do some math!"
        if re.match(r"^(i'?m|i am|im|feeling|feel|so|really|getting)\s+(tired|sleepy|exhausted|worn out)\b", lower):
            return random.choice(["Sounds like you could use some rest 🐒 Want a cozy bedtime story to wind down?",
                "Aw, get some rest 🐒💤 Want a calm little story first?"])
        if re.match(r"^(i'?m|i am|im|so|really|getting)\s+(hungry|starving|peckish)\b", lower):
            return "Me too — always 🍌🐒 I'd split a banana with you if I could! Want a joke while you grab a snack?"
        if re.match(r"^guess what\b", lower):
            return random.choice(["Ooh, what?! 🐒 Tell me!", "What what what? 🐒 I'm all ears!"])
        if re.search(r"\b(play a game|let'?s play|lets play|wanna play|want to play|can we play|play with me)\b", lower):
            return "I'd love to! 🐒 I can't run a full game, but I can do riddles, jokes, fun facts, or spin you a story — what sounds fun?"
        if re.match(r"^(thanks|thank you|thank u|thanx|thx|ty|tysm|much appreciated|appreciate it)\b", lower):
            return random.choice(["You're welcome! 🐒 Anything else I can help with?", "Anytime! 🐒🍌", "Happy to help! 🐒 What's next?"])
        if re.match(r"^(bye|goodbye|good\s?bye|good\s?night|goodnight|night night|nighty\s?night|see (you|ya)( later| soon| around)?|cya|c ya|later|laters|gtg|g2g|gotta go|i('?m| am) (leaving|going)|peace out|adios|farewell|catch you later|talk to you later)\b", lower):
            return random.choice(["See you later! 🐒 Come back anytime — I'll be here swinging.",
                "Bye for now! 🍌 It was fun chatting. 🐒", "Take care! 🐒 I'll save your bananas for you.",
                "Catch you later, friend! 🐒"])
        spell_m = re.match(r"^(?:how (?:do|to) (?:you|i) spell|how to spell|spell|what'?s the spelling of)\s+(?:the word\s+)?([a-z][a-z'-]{1,19})[\s!.?]*$", lower)
        if spell_m:
            word = re.sub(r'[^a-z]', '', spell_m.group(1), flags=re.I)
            if len(word) >= 2:
                return f"{word} is spelled: {'-'.join(word.upper())} 🐒"
        # Good news / achievements (v92)
        if re.match(r"^(yay+|woo+|hooray|yippee|i did it|we did it|i won|we won|i passed|i aced|i finished|i made it|i got it|nailed it|i'?m proud)\b", lower):
            return random.choice(["Woohoo! 🎉🐒 Way to go — I knew you could! Tell me about it!",
                "YESSS 🙌🐒🍌 That's awesome! High five! ✋", "Amazing!! 🎉 So proud of you 🐒 What happened?"])
        if re.match(r"^(i'?m|i am|im|feeling|feel)\s+(happy|excited|great|awesome|amazing|fantastic|good|wonderful|joyful|glad|pumped|stoked)\b", lower):
            return random.choice(["Yay, that makes me happy too! 🐒🍌 What's the good news?",
                "Love that energy! 🐒 What's got you feeling so good?"])
        if re.match(r"^(oops|oh no|uh oh|uh-oh|whoops|my bad|yikes|darn|shoot)\b", lower):
            return random.choice(["Uh oh 🙈 Everything okay? I'm here if you want to talk or need a hand.",
                "Whoops! 🐒 No worries — what happened?"])
        if re.search(r"\bhappy birthday\b|^(it'?s|its) my birthday\b|\bmy birthday\b", lower):
            return random.choice(["A birthday?! 🎂🎉🐒 Happy birthday!! Hope it's full of cake and bananas 🍌",
                "🎂🎈 HAPPY BIRTHDAY! 🐒 Make a wish — and save me a slice!"])
        if re.search(r"\bmerry christmas\b|\bhappy (new year|halloween|thanksgiving|easter|holidays|hanukkah|diwali)\b|\bhappy holidays\b", lower):
            return random.choice(["🎉🐒 Right back at you — hope it's a wonderful one! 🍌",
                "Aw, thank you! 🐒 Wishing you a happy one too! 🎉"])

        # Positive feedback ("I like it", "that was great", "love it") — warm
        # reply instead of falling into the knowledge scorer; offer more if a
        # story is live. (v60 parity — the "i like it" Euler's-number bug.)
        if re.match(r"^((i\s+)?(really\s+)?(like|love|loved|liked|loving|enjoy|enjoyed)\s+(it|that|this(\s+one|\s+story)?)|that('?s|\s+was)(\s+so|\s+really)?\s+(great|good|cool|awesome|nice|fun|lovely|sweet|amazing|perfect)|(so\s+|really\s+)?(good|great|cool|awesome|nice|lovely|fun)\s+(story|one|job|tale)|nice\s+one|well\s+done|good\s+job)(\s+(joe|monkey joe|buddy|pal|friend|man|bro|dude|mj))?[\s!.?]*$", lower):
            if self.story_session:
                return random.choice([
                    "Yay, so glad you liked it! 🐒 Want another? Just say 'another'.",
                    "Aw, thank you! 🐒 I can spin another or make it longer — your call.",
                    "🐒💛 Happy you enjoyed it! Say 'another' for one more."])
            return random.choice([
                "Aw, thank you! 🐒 What should we do next?",
                "🐒💛 You're the best. What's next?",
                "Glad you think so! 🐒 Ask me anything."])

        # Check greetings first (from rules.json). Match ONLY when the whole
        # message is a greeting (+ up to two trailing name/vocative words), so
        # "hi can you help me make a book" falls through to the story handler
        # instead of being swallowed as a greeting. Mirrors the web regex. (v82)
        if self.rules and 'greetings' in self.rules and len(lower) < 40:
            for greeting in self.rules.get('greetings', []):
                for word in greeting.get('if', []):
                    pat = r"^" + re.escape(word) + r"(\s*,?\s+(monkey joe|[a-z']+(\s+[a-z']+)?))?[\s,!.?]*$"
                    if re.match(pat, lower):
                        responses = greeting.get('responses', [])
                        if self.memory.should_welcome_back():
                            return self._with_procedural(self.memory.format_welcome_back())
                        if responses:
                            return self._with_procedural(random.choice(responses))

        # Name recognition — user addresses or asks about Joe by name
        if 'monkey joe' in lower:
            if any(lower.startswith(w) for w in ['hi', 'hey', 'hello', 'howdy', 'hiya', 'yo', 'sup']):
                greetings = self.rules.get('greetings', [{}])
                responses = greetings[0].get('responses', []) if greetings else []
                return random.choice(responses) if responses else "Hey! 🐒"
            return "That's me! 🐒 I'm Monkey Joe — a rules-based AI assistant made by Akiva. Ask me anything!"

        # Check capability questions (before knowledge lookup)
        capability_make = ['can you make', 'can you create', 'can you build', 'can you write',
                           'can you generate', 'can you produce', 'can you design', 'are you able to make',
                           'can you do']
        if any(p in lower for p in capability_make):
            if any(ext in lower for ext in ['spreadsheet', 'excel', 'html', 'python', 'script', 'file', 'image', 'video', 'music', 'song']):
                return "I can create files! Say 'make me a file called name.html' and I'll generate it. Supported: .html .py .sh .md .js .json .css .txt .csv 🐒"
            return "I can answer questions, create files, and push them to GitHub. Ask me anything! 🐒"
        capability_triggers = ['are you able', 'what can you do', 'what do you know',
                               'do you know how to', 'are you capable', 'do you code', 'can you code',
                               'coding ability', 'programming ability']
        if any(t in lower for t in capability_triggers) and len(lower.split()) < 8:
            return "I can answer questions from my knowledge base, help with coding and terminal commands, push files to GitHub, and chat. Ask me anything!"

        # Check for path existence questions
        if any(w in lower for w in ['does', 'exist', 'path exist', 'is there']):
            path_match = re.search(r'(/[^\s?]+)', user_input)
            if path_match:
                path = path_match.group(1)
                exists = os.path.exists(path)
                return f"{'✅ Yes, that path exists.' if exists else '❌ No, that path does not exist.'}"

        # Check for file creation requests
        file_match = re.search(r'(?:make|create|write|generate)\s+(?:me\s+)?(?:a\s+)?(?:file\s+)?(?:called\s+)?([a-zA-Z0-9_\-]+\.[a-zA-Z]+)', lower)
        if file_match:
            filename = file_match.group(1)
            ext = filename.split('.')[-1].lower()
            filepath = os.path.join(os.getcwd(), filename)
            # Get template or create empty file
            template = FILE_TEMPLATES.get(ext, '')
            try:
                with open(filepath, 'w') as f:
                    f.write(template)
                log_file(filepath)
                cwd = os.getcwd()
                return f"Created {filename} in {cwd}/ ✓\nPush it to GitHub with: push {filename}"
            except Exception as e:
                return f"Error creating file: {e}"

        # Story handling — must run before knowledge lookup so "tell me a story
        # about elephants" doesn't get hijacked by the elephant fact lookup.
        story_resp = self.handle_story_input(user_input, lower)
        if story_resp is not None:
            return story_resp

        # Coding dispatchers: error paste, code paste, debug walkthrough, recipe.
        # Runs before knowledge lookup so "merge conflict" gets the walkthrough,
        # not a stray fact match. Order matches brain.js v51.
        coding_resp = self.handle_coding_input(user_input, lower)
        if coding_resp is not None:
            return coding_resp

        # Follow-up to a fresh calculation ("how does this work?" / "explain
        # that") — must beat the science dispatcher, or it hits the physics
        # 'work' tutorial. Only fires on a bare follow-up with a recent answer.
        if (self._last_math_context and self._last_math_age <= 2
                and self._is_math_followup(lower)
                and not self._classify_math_intent(user_input, lower)):
            exp = self._explain_last_math(self._last_math_context)
            if exp:
                self._last_math_age = 99
                return exp

        # Math dispatcher (v55) — slots between coding and knowledge so
        # `is 91 prime` and `25% of 80` win over generic fact lookup.
        # Counting & sequence (v95)
        m = re.match(r'^count(?:\s+up)?\s+(?:from\s+(\d+)\s+)?to\s+(\d+)', lower)
        if m:
            a = int(m.group(1)) if m.group(1) else 1; b = int(m.group(2))
            if b > a + 100: b = a + 100
            return ', '.join(str(i) for i in range(a, b + 1)) + '! 🐒'
        m = re.match(r'^count\s+down\s+from\s+(\d+)', lower)
        if m:
            a = min(int(m.group(1)), 100)
            return ', '.join(str(i) for i in range(a, -1, -1)) + ' — liftoff! 🚀🐒'
        m = re.search(r"\bwhat(?:'?s)?\s+comes?\s+after\s+(-?\d+)", lower)
        if m:
            return f'{int(m.group(1)) + 1}! 🐒'
        m = re.search(r"\bwhat(?:'?s)?\s+comes?\s+before\s+(-?\d+)", lower)
        if m:
            return f'{int(m.group(1)) - 1}! 🐒'

        # Numeric comparison (v96)
        _nums = [float(x) if '.' in x else int(x) for x in re.findall(r'-?\d+(?:\.\d+)?', lower)]
        if (re.search(r'\b(bigger|larger|greater|higher|biggest|largest|smaller|less|lower|smallest|fewer)\b', lower)
                and re.search(r"\b(which|what'?s|what is|whats|is)\b", lower)
                and len(_nums) == 2 and not re.search(r'[+*/^%]', lower)):
            a, b = _nums
            big = bool(re.search(r'\b(bigger|larger|greater|higher|biggest|largest|more)\b', lower))
            word = 'bigger' if big else 'smaller'
            if a == b:
                return "They're equal — both {}! 🐒".format(a)
            if re.search(r'\bthan\b', lower):
                yes = (a > b) if big else (a < b)
                if yes:
                    return 'Yes! {} is {} than {}. 🐒'.format(a, word, b)
                return 'Nope — {} is the {} one. 🐒'.format(max(a, b) if big else min(a, b), word)
            ans = max(a, b) if big else min(a, b)
            return '{}! 🐒 (the {} of {} and {})'.format(ans, word, a, b)

        # Even/odd parity (v90)
        parity_m = re.search(r'\bis\s+(-?\d+)\s+(?:an?\s+)?(?:even|odd)(?:\s+number)?\b|\bis\s+(-?\d+)\s+(?:even or odd|odd or even)\b', lower)
        if parity_m:
            n = int(parity_m.group(1) if parity_m.group(1) is not None else parity_m.group(2))
            even = (n % 2 == 0)
            return f"{n} is {'even' if even else 'odd'}! 🐒 " + ("It splits into two equal halves." if even else "It can't split evenly into two.")

        math_intent = self._classify_math_intent(user_input, lower)
        if math_intent:
            math_resp = self._handle_math_intent(math_intent, user_input, lower)
            if math_resp is not None:
                # COMPUTE/WORKED answers may get a one-line voice garnish.
                # TEACH/DEFINE already end on a tryIt prompt.
                if math_intent in ('COMPUTE', 'WORKED'):
                    return self._maybe_garnish_math(math_resp, user_input, lower)
                return math_resp

        # Science dispatcher (v55) — after math, before knowledge.
        sci_intent = self._classify_science_intent(user_input, lower)
        if sci_intent:
            sci_resp = self._handle_science_intent(sci_intent, user_input, lower)
            if sci_resp is not None:
                if sci_intent == 'SCIENCE_FORMULA':
                    return self._maybe_garnish_science(sci_resp, user_input, lower)
                return sci_resp

        # Terminal/command dispatcher — fires when input looks like a command OR
        # is a question ABOUT a command (gated on a command-context word so
        # "what is a cat" stays the animal). Mirrors the web; terminal.json was
        # loaded but never read in the CLI. (v82 parity)
        terms = self.terminal.get('commands') if isinstance(self.terminal, dict) else self.terminal
        if terms:
            about_command = bool(re.search(r'\b(command|terminal|cli|command line|shell|bash)\b', lower))
            for entry in terms:
                trigs = entry.get('triggers') or []
                direct = any(lower == t or lower.startswith(t + ' ') or lower.startswith(t + ':')
                             or (re.match(r'^(run|execute|use|type)\s', lower) and t in lower) for t in trigs)
                asked = about_command and any(self._word_contains(lower, t) for t in trigs)
                if direct or asked:
                    return entry.get('response', '')

        # Rejection of the previous answer/story — "that doesn't go with my
        # drawing", "that story doesn't fit", "not what I drew", "wrong story".
        # Catch before the keyword scorer ("match"→pattern-matching fact). (v80 A)
        if re.search(r"\b(does(n'?t| not)\s+(go\s+with|match|fit|relate|belong|sound\s+right)|(that|this|the)\s+(story|one|answer)\s+(does(n'?t| not)|is\s*n'?t|wasn'?t)|not\s+(what|how)\s+i\s+(drew|asked|wanted|meant|said|wrote)|that'?s\s+not\s+(the\s+)?(story|one|it)\b|wrong\s+(story|one))\b", lower):
            if self.story_session:
                return random.choice([
                    "Oops, my story wandered off the trail 🐒 Want me to spin another? Just say 'another'.",
                    "Fair — that one didn't fit! 🙈 Say 'another' and I'll try a fresh story.",
                    "Yeah, my story brain got a little loopy 🐒 Want a different one? Say 'another'."])
            return random.choice([
                "Whoops, that missed 🐒 Tell me what you're after and I'll try again.",
                "My bad — that didn't fit! 🙈 What were you actually looking for?",
                "Hmm, not quite right 🐒 Say it a different way and I'll have another go."])

        # Meta / feedback ABOUT Joe ("you didn't answer", "that's wrong", "I'll
        # tell Claude to fix you") — respond humbly instead of dumping a fact
        # that merely shares a keyword like "Claude". (v61 parity)
        if re.search(r"\b(you('?re| are)?\s+wrong|wrong\s+(answer|response)|that('?s| was)?\s*(not\s+(right|it|what\s+i)|wrong)|did(n'?t| not)\s+(answer|help|work|understand)|not\s+the\s+right\s+(answer|response|thing)|does(n'?t| not)\s+make\s+sense|made\s+no\s+sense|you('?re| are)?\s+(broken|useless|dumb|stupid|not\s+working)|fix\s+you|tell\s+(claude|akiva)|report\s+you|bad\s+(bot|monkey|answer|response)|you\s+(suck|messed\s+up|don'?t\s+work)|wrong\s+again)\b", lower):
            return random.choice([
                "Oof, sorry — I'm just a rules-based monkey, so I flub things sometimes. 🐒 What were you hoping I'd say?",
                "You're right, that one missed. 🙈 Akiva and Claude keep teaching me — what did you actually want?",
                "My bad! 🐒 Tell me what you meant and I'll have another go.",
                "Yeah, that wasn't my best. 🐒 Want to ask me again a different way?"])

        # Meta: user says they're improving/building/working on Joe (often
        # naming Claude/Akiva). Without this it hits the Anthropic fact via its
        # "claude" keyword and dumps the founding story. (v77, Bug 1)
        # Require an explicit make/improve verb targeting "you" — the old bare
        # "better...you" alternative misfired on "is dark chocolate better for
        # you". (v82 audit fix)
        improve_you = (re.search(r"\b(make|making|made|help|helping)\b.*\byou\b.*\b(better|smarter|smart)\b", lower)
                       or re.search(r"\bmake\s+you\s+(better|smarter)\b", lower))
        verb_you = re.search(r"\b(improv\w*|upgrad\w*|fix\w*|building|build|train\w*|teach\w*|tweak\w*|tun\w*|perfect\w*|polish\w*)\s+(you|joe|monkey joe)\b", lower)
        working_ctx = re.search(r"\bwork(ing)?\s+(on|with)\b", lower) and re.search(r"\b(claude|you|joe|monkey joe)\b", lower)
        if improve_you or verb_you or working_ctx:
            return random.choice([
                "Aw, thanks for working on me! 🐒 Every tweak makes me a little less of a goofball. What should we try?",
                "🐒 You and Claude are making me smarter? I'm honored! Ask me something and let's see how I'm doing.",
                "Heck yeah — better Monkey Joe incoming! 🍌 What do you want me to handle better?",
                "That means a lot! 🐒 Throw something at me and let's test the new me."])

        # Check for casual statements (not questions)
        if self.is_casual_statement(lower):
            casual_responses = [
                "Ha, agreed! 🐒 What do you want to know?",
                "Nice! Anything I can help with?",
                "Cool! Ask me something.",
                "Interesting take! What's on your mind?",
                "🐒 What can I do for you?"
            ]
            return random.choice(casual_responses)

        # Apply contextual follow-up
        lower = self.apply_contextual_followup(lower)

        # Build query variants
        stripped = self.strip_question(lower)
        expanded = self.expand_synonyms(lower)
        str_expanded = self.expand_synonyms(stripped)
        topic = self.extract_topic(lower)
        variants = [lower, stripped, expanded, str_expanded]
        if topic:
            variants.extend([topic, self.expand_synonyms(topic)])

        # Score all facts
        best_fact = None
        best_score = 0.0
        all_sources = self.knowledge + self.coding

        for fact in all_sources:
            score = self.score_fact(fact, variants)
            if score > best_score:
                best_score = score
                best_fact = fact

        # Return answer if score >= 1.5 (parity with the web threshold so the
        # sub-topic extraction / category checks actually run; below this is a
        # soft topic suggestion). (v77)
        if best_fact and best_score >= 1.5:
            # Bug 7: category question whose asserted type the fact contradicts.
            # Skip on comparisons ("which is faster, a cheetah or a horse"). (v87)
            cat_q = None if re.search(r'\b(or|than|vs|versus)\b', lower) else self._detect_category_q(lower)
            if cat_q and len(cat_q['name']) >= 3 and len(cat_q['category']) >= 3:
                hay = (best_fact.get('answer', '') + ' ' + ' '.join(best_fact.get('keywords', []))).lower()
                if not re.search(r'\b' + re.escape(cat_q['category']) + r's?\b', hay):
                    clause = re.split(r'(?<=[.!?])\s+', best_fact.get('answer', ''))[0]
                    return f"Hmm, I don't think there's a {cat_q['category']} called \"{cat_q['name']}\". What I've got for \"{cat_q['name']}\" is: {clause} 🐒"
            # Bug E: don't re-serve the exact fact Joe just gave.
            prev_fact_answer = self.last_fact_answer
            self.last_topic_label = best_fact['keywords'][0] if best_fact.get('keywords') else None
            self.last_fact_answer = best_fact.get('answer', '')
            if self.last_topic_label:
                self.memory.record_topic(self.last_topic_label)
            answer = best_fact.get('answer', '')
            # Bug 3/5: narrow sub-topic question → just the focused sentence(s).
            intent_words = self._get_intent(lower)
            focused = self._extract_focused(answer, intent_words) if intent_words else None
            if focused:
                answer = focused
            elif len(answer) > 500:
                # Summarize very long answers
                sentences = answer.split('. ')
                answer = '. '.join(sentences[:3]) + '.'
            # Bug E: about to reprint the exact fact just given → don't.
            if answer == prev_fact_answer:
                return random.choice([
                    "I think I just covered that one 🐒 — want me to dig at it differently, or search the web for more?",
                    "That's the same thing I just told you 🙈 Ask a different way and I'll give it another shot!",
                    "Ha, déjà vu 🐒 I already shared what I've got on that — want me to search the web for the rest?"])
            # Phase 3: maybe wrap in flavor, then maybe append story hook.
            if focused is None and self._should_flavor(lower):
                answer = self._flavor_fact(answer, None)
                self._recent_flavor_age = 0
            return self._maybe_append_story_hook(answer, best_fact)

        # Partial match — suggest the topic Joe does know about
        if best_fact and best_score >= 0.5:
            topic = best_fact['keywords'][0]
            return f"I'm not sure about that specific question, but I know about {topic}! Ask me something more specific about it. 🐒"

        # Plain IDK — no procedural micro-story prepend (it read as a story +
        # "I don't know", confusing especially after a story request). (v79 R6)
        return "Hmm, I don't know that one yet 🐒 Try asking me to search the web, or ask Akiva to add it to my brain!"

    def github_push(self, file_path: str) -> bool:
        """Push file to GitHub using API."""
        if not os.path.exists(TOKEN_FILE):
            print(f"{RED}Error: ~/.mj_token not found. Create it with: echo 'YOUR_TOKEN' > ~/.mj_token && chmod 600 ~/.mj_token{RESET}")
            return False

        try:
            with open(TOKEN_FILE) as f:
                token = f.read().strip()

            file_to_push = os.path.abspath(file_path)

            if not os.path.exists(file_to_push):
                print(f"{RED}Error: File not found: {file_path}{RESET}")
                return False

            # Calculate path relative to repo
            repo_path = SCRIPT_DIR
            try:
                rel_path = os.path.relpath(file_to_push, repo_path)
            except ValueError:
                print(f"{RED}Error: File must be in Mj.ai repo{RESET}")
                return False

            with open(file_to_push, 'r', encoding='utf-8') as f:
                content = f.read()
            import base64
            content_b64 = base64.b64encode(content.encode()).decode()

            url = f"https://api.github.com/repos/akivamac/Mj.ai/contents/{rel_path}"
            headers = {
                'Authorization': f'Bearer {token}',
                'Accept': 'application/vnd.github+json',
            }

            # Get current file SHA
            resp = requests.get(url, headers=headers)
            sha = resp.json().get('sha') if resp.status_code == 200 else None

            data = {
                'message': f'chore: update {rel_path} via mj CLI',
                'content': content_b64,
                'branch': 'main',
            }
            if sha:
                data['sha'] = sha

            resp = requests.put(url, json=data, headers=headers)
            if resp.status_code in [201, 200]:
                print(f"{GREEN}✓ Pushed {rel_path} to GitHub{RESET}")
                return True
            else:
                print(f"{RED}Error: {resp.json().get('message', 'Push failed')}{RESET}")
                return False
        except Exception as e:
            print(f"{RED}Error: {e}{RESET}")
            return False

