                if any(lower_input.startswith(p) for p in joe_self) and len(lower_input.split()) < 10:
                    print("Joe: I'm a rules-based assistant — I don't have accounts, tokens, memory between sessions, or personal state. I just answer questions from my brain! 🐒\n")
                    continue

                # Statement directed at Joe — not a question
                if is_statement_about_joe(user_input):
                    stmt_responses = [
                        "Ha, noted! What do you want to know? 🐒",
                        "Interesting observation! What can I help you with?",
                        "I'll take your word for it! What do you need?",
                        "Fair enough! What's your question?",
                        "You might be right about that! Ask me anything. 🐒",
                    ]
                    print(f"Joe: {random.choice(stmt_responses)}\n")
                    continue

                # Get response
                response = self.respond(user_input)

                # Short catch-alls for no-match responses
                question_words = ['what', 'who', 'how', 'why', 'where', 'when', 'which', 'is',
                                  'are', 'do', 'does', 'did', 'can', 'could', 'would', 'should', 'will']
                if response.startswith("Hmm, I don't know"):
                    emotional_words = ['feel', 'love', 'hate', 'miss', 'wish', 'hope', 'scared',
                                       'excited', 'happy', 'sad', 'angry', 'tired', 'nervous', 'worried']
                    is_emotional = any(w in lower_input for w in emotional_words)
                    is_question = any(lower_input.startswith(w) for w in question_words) or '?' in lower_input
                    if is_emotional and not is_question:
                        print(f"Joe: {random.choice(['That sounds meaningful! I can answer questions on lots of topics — what do you want to know? 🐒', 'I hear you! Not much of an emotional support monkey, but I can answer questions. 🐒', 'Thanks for sharing! Ask me a question and I' + chr(39) + 'll do my best.'])}\n")
                    elif self.last_topic_label and len(lower_input.split()) <= 3 and not is_question:
                        print(f"Joe: Not sure about that — did you want to know more about {self.last_topic_label}? 🐒\n")
                    elif len(lower_input.split()) <= 2 and not is_question:
                        print("Joe: Can you ask me a full question? I'll do my best to answer! 🐒\n")
                    elif len(lower_input.split()) <= 4 and not is_question:
                        print("Joe: Tell me more, or ask me a question! 🐒\n")
                    else:
                        print(f"Joe: {response}\n")
                    continue

                print(f"Joe: {response}\n")

                # Store exchange
                self.history.append({'you': user_input, 'joe': response})
                if len(self.history) > 10:
                    self.history.pop(0)

            except KeyboardInterrupt:
                print("\n🐒 Bye!")
                break
            except Exception as e:
                print(f"{RED}Error: {e}{RESET}\n")

