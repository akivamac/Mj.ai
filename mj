    def _handle_math_intent(self, intent, input_str, lower):
        if intent in ('TEACH', 'DEFINE'):
            return self._handle_tutorial(intent, input_str, lower)
        worked = intent == 'WORKED'
        f = self._math_fmt
        # 1. Conversion
        if MathEngine.parse_conversion(input_str):
            c = MathEngine.convert_unit(input_str)
            if c: return f"{f(c['input'])} {c['from']} = {f(c['value'])} {c['to']}"
        # 2. Equation solving (always show work — equations benefit from it)
        if '=' in input_str and re.search(r'(?<![a-z])x(?![a-z])', input_str, re.I):
            eq = MathEngine.solve_equation(input_str)
            if eq: return self._format_equation_answer(eq, True)
        # 3. Prime / prime factor
        m = re.search(r'\bis\s+(\d+)\s+prime\b', lower)
        if m: return self._format_prime_check(int(m.group(1)), worked)
        m = re.match(r'^(?:factor|prime factor|factorize|factorise|primes? of)\s+(\d+)', lower)
        if m:
            n = int(m.group(1))
            fac = MathEngine.prime_factor(n)
            return f"{n} = {' × '.join(map(str, fac))}" if fac else f"{n} has no prime factors (≤ 1)."
        # 4. Stats
        if re.match(r'^(mean|median|mode|average|stats|stddev|stdev|variance|sum|range)\b', input_str.strip(), re.I):
            nums = MathEngine.parse_number_list(input_str)
            if nums:
                s = MathEngine.summarize(nums)
                which = input_str.strip().lower().split()[0]
                if which in ('mean', 'average'):
                    return (f"mean = {f(s['mean'])}\n\nWork: ({' + '.join(map(str, nums))}) / {s['n']} = {f(s['sum'])} / {s['n']} = {f(s['mean'])}"
                            if worked else f(s['mean']))
                if which == 'median':   return f(s['median'])
                if which == 'mode':     return f(s['mode']) if s['mode'] is not None else 'No mode — all values unique.'
                if which in ('stddev', 'stdev'): return f(s['stdev'])
                if which == 'variance': return f(s['variance'])
                if which == 'sum':      return f(s['sum'])
                if which == 'range':    return f(s['range'])
                return self._format_stats_summary(s, worked)
        # 5. Plain expression
        if MathEngine.looks_like_math(input_str):
            r = MathEngine.evaluate_expression(input_str)
            if r and 'error' not in r:
                # Remember it so a follow-up "how does this work?" explains the
                # operation instead of hitting the physics 'work' tutorial.
                self._last_math_context = {'cleaned': r.get('cleaned', ''), 'result': f(r['value'])}
                self._last_math_age = 0
                return f(r['value'])
        return None

    _MATH_FOLLOWUP_RE = re.compile(
        r"^(how (?:does|do|did|d)?\s*(?:this|that|it|you)?\s*(?:work|works|do that|get that|figure that out|work that out)"
        r"|how'?d you (?:do|get) that|how come|explain (?:that|this|it|how)?|show me how|but how|what do you mean|how so)"
        r"[\s?.!]*$", re.I)

    def _is_math_followup(self, lower):
        return bool(self._MATH_FOLLOWUP_RE.match(lower.strip()))

    def _explain_last_math(self, ctx):
        if not ctx or not ctx.get('cleaned'):
            return None
        expr, res = ctx['cleaned'], ctx['result']
        bin_m = re.match(r'^\(?\s*(-?\d+(?:\.\d+)?)\s*\)?\s*([-+*/^])\s*\(?\s*(-?\d+(?:\.\d+)?)\s*\)?$', expr)
        if bin_m:
            a, op, b = bin_m.group(1), bin_m.group(2), bin_m.group(3)
            if op == '+': return f'Adding means putting amounts together. You combine {a} and {b} into one total, which gives {res}. Want the long way? Say "show your work". 🐒'
            if op == '-': return f"Subtracting means taking away. You start with {a} and remove {b}, and what's left is {res}. Want it broken down? Say \"show your work\". 🐒"
            if op == '*': return f'Multiplying is fast repeated adding — "{a}, {b} times". So {a} × {b} stacks up to {res}. Want the steps? Say "show your work". 🐒'
            if op == '/': return f'Dividing is splitting into equal groups. {a} ÷ {b} asks "how many {b}s fit in {a}?" — the answer is {res}. Want it step by step? Say "show your work". 🐒'
            if op == '^': return f'An exponent is repeated multiplying. {a}^{b} means {a} multiplied by itself {b} times, which comes to {res}. 🐒'
        if re.search(r'%|/100', expr):
            return f'A percent is a piece out of 100. I turned the percent into a fraction over 100, then multiplied — that lands on {res}. Want the steps? Say "show your work". 🐒'
        return f'I worked it out left to right following order of operations (PEMDAS: parentheses, exponents, then ×/÷, then +/−), which gives {res}. Want me to show each step? Say "show your work". 🐒'

    def handle_story_input(self, user_input, lower):
        """Returns response string if input is a story request/continuation/reset/another; else None."""
        NO_STORY_MSG = "I don't have a story going yet — try 'tell me a story about a fox' to get one started! 🐒"

        if self._detect_story_reset(lower):
            if self.story_session:
                self.story_session = None
                return "OK, ending that story. Tell me when you want a new one! 🐒"
            return NO_STORY_MSG

        m = re.match(r'^chapter\s+(\d+)[\s!.?]*$', lower)
        if m:
            if self.story_session:
                num = int(m.group(1))
                r = self.generate_story({'continuation': True,
                                         'tone': self.story_session.get('tone'),
                                         'character': self.story_session.get('character'),
                                         'place': self.story_session.get('place')})
                self.story_session['character']   = r.get('character') or self.story_session.get('character')
                self.story_session['place']       = r.get('place')     or self.story_session.get('place')
                self.story_session['chapter']     = num
                self.story_session['chapterMode'] = True
                return f"Chapter {num}\n\n{r['text']}"
            return NO_STORY_MSG

        if self._detect_story_continuation(lower):
            if self.story_session:
                r = self.generate_story({'continuation': True,
                                         'tone': self.story_session.get('tone'),
                                         'character': self.story_session.get('character'),
                                         'place': self.story_session.get('place')})
                self.story_session['character'] = r.get('character') or self.story_session.get('character')
                self.story_session['place']     = r.get('place')     or self.story_session.get('place')
                prefix = ''
                if self.story_session.get('chapterMode'):
                    self.story_session['chapter'] = (self.story_session.get('chapter') or 1) + 1
                    prefix = f"Chapter {self.story_session['chapter']}\n\n"
                return prefix + r['text']
            return NO_STORY_MSG

        if self._detect_another(user_input):
            if self.story_session:
                r = self.generate_story({'tone': self.story_session.get('tone'),
                                         'subject': self.story_session.get('subject'),
                                         'mode': 'beats' if self.story_session.get('mode') == 'beats' else 'regular'})
                self.story_session['character'] = r.get('character') or self.story_session.get('character')
                self.story_session['place']     = r.get('place')     or self.story_session.get('place')
                return r['text']

        # "Make it longer" / "bigger" — upgrade the current story instead of
        # treating it as a brand-new request (v60 parity with brain.js). Only
        # fires when a session is live: micro grows to regular, regular to beats.
        if self.story_session \
           and re.search(r'\b(longer|bigger|not (big|long) enough|make it (longer|big|bigger)|too short|expand it|more detail)\b', lower) \
           and not re.search(r'\bstory about\b|\btell me a story\b', lower):
            next_mode = 'regular' if self.story_session.get('mode') == 'micro' else 'beats'
            r = self.generate_story({'tone': self.story_session.get('tone'),
                                     'subject': self.story_session.get('subject'),
                                     'character': self.story_session.get('character'),
                                     'place': self.story_session.get('place'),
                                     'mode': next_mode})
            self.story_session['character'] = r.get('character') or self.story_session.get('character')
            self.story_session['place']     = r.get('place')     or self.story_session.get('place')
            self.story_session['mode']      = r.get('mode') or next_mode
            return r['text']

        about = self._detect_about_micro(lower)
        if about:
            r = self.generate_story({'mode': 'micro', 'subject': about['noun'],
                                     'tone': self._detect_story_tone(lower)})
            if r.get('text'):
                self.story_session = {'tone': r.get('tone'), 'subject': about['noun'],
                                      'character': r.get('character'), 'place': r.get('place'),
                                      'chapter': 1, 'chapterMode': False, 'mode': 'micro'}
                return r['text']

        if self._is_story_request(user_input):
            tone    = self._detect_story_tone(lower)
            mode    = self._detect_story_mode(lower)
            subject = self._extract_story_subject(lower)
            fact    = self._find_fact_for_subject(subject)
            bind_subject = subject.get('lastSingular') or subject.get('lastWord') or \
                           subject.get('singular') or subject.get('raw')
            r = self.generate_story({'tone': tone, 'mode': mode or 'regular',
                                     'subject': bind_subject,
                                     'fact': fact.get('answer') if fact else None})
            ch = re.search(r'\bchapter\s+(\d+)\b', user_input, re.I)
            self.story_session = {'tone': tone, 'subject': bind_subject,
                                  'character': r.get('character'), 'place': r.get('place'),
                                  'chapter': int(ch.group(1)) if ch else 1,
                                  'chapterMode': bool(ch),
                                  'mode': r.get('mode') or mode or 'regular'}
            prefix = f"Chapter {self.story_session['chapter']}\n\n" if self.story_session['chapterMode'] else ''
            return prefix + r['text']

        return None

    # ── Coding dispatchers (Python port of brain.js v51) ──────
    def _detect_error_pattern(self, input_str):
        patterns = (self.errors or {}).get('patterns') or []
        best, best_len = None, 0
        for p in patterns:
            try:
                m = re.search(p['match'], input_str)
            except re.error:
                continue
            if m and len(m.group(0)) > best_len:
                best, best_len = (p, m), len(m.group(0))
        return best

    @staticmethod
    def _sub_captures(text, m):
        if not text: return ''
        def repl(mt):
            idx = int(mt.group(1))
            try: return m.group(idx) if m.group(idx) is not None else ''
            except (IndexError, re.error): return ''
        return re.sub(r'\{(\d+)\}', repl, text)

    def _format_error_response(self, hit):
        entry, m = hit
        diagnosis = self._sub_captures(entry.get('diagnosis', ''), m)
        fixes = [self._sub_captures(f, m) for f in (entry.get('fixes') or [])]
        out = f"**{entry.get('title','Error')}**\n\n{diagnosis}"
        if fixes:
            out += "\n\n**Try:**\n" + "\n".join('• ' + f for f in fixes)
        if entry.get('example_fix'):
            out += f"\n\n**Example fix:**\n```\n{entry['example_fix']}\n```"
        return out

    @staticmethod
    def _word_contains(haystack, needle):
        """Substring match respecting word boundaries — `ph` in
        `photosynthesis` must NOT match."""
        i = 0
        while i < len(haystack):
            j = haystack.find(needle, i)
            if j < 0: return False
            before = haystack[j-1] if j > 0 else ' '
            end = j + len(needle)
            # Tolerate a single trailing plural 's' so a singular trigger
            # ("punnett square") matches a plural query ("punnett squares"). v64
            if end < len(haystack) and haystack[end] == 's' and not needle.endswith('s'):
                end += 1
            after = haystack[end] if end < len(haystack) else ' '
            if not before.isalpha() and not after.isalpha(): return True
            i = j + 1
        return False

    @staticmethod
    def _find_by_triggers(entries, lower, min_score=2):
        if not entries: return None
        best, best_score = None, 0
        wc_fn = MonkeyJoe._word_contains
        for e in entries:
            score = 0
            for trig in (e.get('triggers') or []):
                t = trig.lower()
                wc = len([w for w in t.split() if len(w) > 1])
                if wc_fn(lower, t):
                    score += 3 if wc >= 2 else 2
                    continue
                if wc >= 2:
                    words = [w for w in t.split() if len(w) > 1]
                    if all(wc_fn(lower, w) for w in words):
                        score += 1
            if score > best_score:
                best_score, best = score, e
        return best if best_score >= min_score else None

    def _format_recipe(self, r):
        lang = (r.get('languages') or [''])[0]
        out = f"**{r.get('title','Recipe')}**\n\n```{lang}\n{r.get('code','')}\n```"
